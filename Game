      /* -----------------------------------------------------------------------
         3. YARDIMCI MATEMATİK VE DEPOLAMA FONKSİYONLARI
         ----------------------------------------------------------------------- */
      const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
      const rand = (min, max) => min + Math.random() * (max - min);
      const distSq = (x1, y1, x2, y2) => {
        const dx = x2 - x1;
        const dy = y2 - y1;
        return dx * dx + dy * dy;
      };
      const dist = (x1, y1, x2, y2) => Math.hypot(x2 - x1, y2 - y1);

      function loadStorageNumber(key, fallback = 0) {
        try {
          const val = Number(localStorage.getItem(key));
          return Number.isFinite(val) ? val : fallback;
        } catch {
          return fallback;
        }
      }

      function saveStorageValue(key, value) {
        try {
          localStorage.setItem(key, String(value));
        } catch {
          // Depolama kısıtlı ortamlarda sessizce devam et
        }
      }

      function loadStorageBool(key, fallback = false) {
        try {
          const val = localStorage.getItem(key);
          return val === null ? fallback : val === 'true';
        } catch {
          return fallback;
        }
      }

      function pointToSegmentDistance(px, py, x1, y1, x2, y2) {
        const dx = x2 - x1;
        const dy = y2 - y1;
        const lenSq = dx * dx + dy * dy;
        if (lenSq === 0) return dist(px, py, x1, y1);
        let t = ((px - x1) * dx + (py - y1) * dy) / lenSq;
        t = clamp(t, 0, 1);
        return dist(px, py, x1 + t * dx, y1 + t * dy);
      }

      /* -----------------------------------------------------------------------
         4. WEB AUDIO API SES MOTORU + KOMBOYA BAĞLI DİNAMİK RİTİM
         ----------------------------------------------------------------------- */
      const Sound = {
        ctx: null,
        muted: loadStorageBool(STORAGE_MUTE, false),
        beatTimer: 0,
        beatStep: 0,
        beatPulse: 0,

        init() {
          if (this.muted) return;
          try {
            if (!this.ctx) {
              const AudioCtx = window.AudioContext || window.webkitAudioContext;
              if (AudioCtx) this.ctx = new AudioCtx();
            }
            if (this.ctx && this.ctx.state === 'suspended') {
              this.ctx.resume().catch(() => {});
            }
          } catch {
            // Ses motoru başlatılamazsa sessiz devam et
          }
        },

        toggleMute() {
          this.muted = !this.muted;
          saveStorageValue(STORAGE_MUTE, this.muted);
          updateSoundUI();
          if (!this.muted) {
            this.init();
            this.playTone(540, 0.08, 'sine', 0.08, 720);
          }
        },

        playTone(freq, duration, type = 'sine', volume = 0.1, endFreq = null, delay = 0) {
          if (this.muted) return;
          this.init();
          if (!this.ctx) return;
          try {
            const now = this.ctx.currentTime + delay;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(Math.max(20, freq), now);
            if (endFreq !== null) {
              osc.frequency.exponentialRampToValueAtTime(Math.max(20, endFreq), now + duration);
            }
            gain.gain.setValueAtTime(0.0001, now);
            gain.gain.linearRampToValueAtTime(volume, now + 0.008);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + duration + 0.02);
          } catch {
            // Ses hatasını yoksay
          }
        },

        playNoise(duration, volume = 0.08, highpass = 600) {
          if (this.muted) return;
          this.init();
          if (!this.ctx) return;
          try {
            const now = this.ctx.currentTime;
            const bufferSize = Math.max(1, Math.floor(this.ctx.sampleRate * duration));
            const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
              data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.45));
            }
            const src = this.ctx.createBufferSource();
            src.buffer = buffer;

            const filter = this.ctx.createBiquadFilter();
            filter.type = 'highpass';
            filter.frequency.setValueAtTime(highpass, now);

            const gain = this.ctx.createGain();
            gain.gain.setValueAtTime(volume, now);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

            src.connect(filter);
            filter.connect(gain);
            gain.connect(this.ctx.destination);
            src.start(now);
          } catch {
            // Yoksay
          }
        },

