        updateRhythm(dt, combo, active) {
          this.beatPulse = Math.max(0, this.beatPulse - dt * 3.8);
          if (!active) return;

          // Kombo arttıkça BPM 108 -> 148 arasına çıkar
          const bpm = 108 + (combo - 1) * 10;
          const stepDuration = 60 / bpm / 2; // Sekizlik nota adımı
          this.beatTimer += dt;
          if (this.beatTimer < stepDuration) return;
          this.beatTimer -= stepDuration;

          const step = this.beatStep % 8;
          this.beatStep++;

          // Görsel kenar nabzı (her vuruşta)
          if (step % 2 === 0) {
            this.beatPulse = 0.45 + (combo - 1) * 0.14;
          }

          if (this.muted || !this.ctx || this.ctx.state !== 'running') return;

          // Kick / Bas nabzı
          if (step === 0 || step === 4) {
            this.playTone(88, 0.11, 'sine', 0.055, 38);
          }
          // x2+ Kombo: Bas yürüyüşü
          if (combo >= 2 && (step === 2 || step === 6)) {
            const bassNotes = [55, 65.41, 73.42, 61.74];
            const freq = bassNotes[Math.floor(this.beatStep / 4) % bassNotes.length];
            this.playTone(freq, 0.1, 'triangle', 0.045, freq * 0.92);
          }
          // x3+ Kombo: İnce hi-hat ritmi
          if (combo >= 3 && step % 2 === 1) {
            this.playNoise(0.035, 0.018, 5200);
          }
          // x4+ Kombo: Neon arpej katmanı
          if (combo >= 4) {
            const arp = [220, 261.63, 329.63, 392, 440, 392, 329.63, 293.66];
            const note = arp[step] * (combo === 5 ? 1.25 : 1);
            this.playTone(note, 0.075, 'sine', 0.025, note);
          }
        }
