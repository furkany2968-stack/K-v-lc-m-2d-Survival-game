<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>KIVILCIM — Tam Ekran 2D Neon Hayatta Kalma Arenası</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    /* =====================================================================
       GENEL DEĞİŞKENLER VE TAM EKRAN TEMEL STİLLERİ
       ===================================================================== */
    :root {
      --bg-space: #06070d;
      --glass-bg: rgba(9, 13, 25, 0.66);
      --glass-border: rgba(148, 163, 184, 0.18);
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --cyan: #00f5ff;
      --gold: #ffd166;
      --crimson: #ff3366;
      --orange: #ff8811;
      --violet: #b55cff;
      --emerald: #38ef7d;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background-color: var(--bg-space);
      color: var(--text-main);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      touch-action: none;
    }

    /* =====================================================================
       TAM EKRAN OYUN ARENASI (100vw x 100vh)
       ===================================================================== */
    canvas#gameCanvas {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      margin: 0;
      display: block;
      background: var(--bg-space);
      cursor: crosshair;
      touch-action: none;
      z-index: 1;
    }

    /* =====================================================================
       YÜZER VE YARI SAYDAM ÜST HUD (OYUN ALANINI DARALTMAZ)
       ===================================================================== */
    .floating-hud {
      position: fixed;
      top: 14px;
      left: 16px;
      right: 16px;
      display: flex;
      flex-direction: column;
      gap: 7px;
      pointer-events: none;
      z-index: 10;
    }

    .hud-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .hud-cluster {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      padding: 6px 12px;
      border-radius: 14px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(8px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.32);
    }

    .hud-brand {
      display: flex;
      align-items: center;
      gap: 7px;
      padding-right: 10px;
      border-right: 1px solid var(--glass-border);
    }

    .brand-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 10px var(--cyan);
    }

    .brand-name {
      font-size: 0.82rem;
      font-weight: 900;
      letter-spacing: 0.14em;
    }

    .stat-chip {
      display: flex;
      flex-direction: column;
      min-width: 56px;
    }

    .stat-label {
      font-size: 0.56rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--text-muted);
      line-height: 1.1;
    }

    .stat-value {
      font-size: 1rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      line-height: 1.15;
      color: var(--text-main);
      transition: transform 0.12s ease, color 0.12s ease;
    }

    .stat-value.pop {
      transform: scale(1.16);
      color: var(--gold);
    }

    .stat-value.gold { color: var(--gold); }

    .meter-chip {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 86px;
    }

    .meter-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .meter-badge {
      font-size: 0.7rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
    }

    .meter-track {
      width: 100%;
      height: 5px;
      background: rgba(148, 163, 184, 0.18);
      border-radius: 999px;
      overflow: hidden;
    }

    .meter-fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.06s linear;
    }

    .meter-fill.combo {
      background: linear-gradient(90deg, #ff9f1c, #ffd166);
      box-shadow: 0 0 8px rgba(255, 209, 102, 0.7);
    }

    .meter-fill.dash {
      background: linear-gradient(90deg, #00b4d8, #00f5ff);
      box-shadow: 0 0 8px rgba(0, 245, 255, 0.75);
    }

    .meter-fill.dash.cooling {
      background: linear-gradient(90deg, #475569, #64748b);
      box-shadow: none;
    }

    .meter-fill.gold-progress {
      background: linear-gradient(90deg, #f59e0b, #ffd166, #fff3b0);
      box-shadow: 0 0 8px rgba(255, 209, 102, 0.72);
    }

    .meter-fill.poison {
      background: linear-gradient(90deg, #16a34a, #22c55e, #4ade80);
      box-shadow: 0 0 10px rgba(34, 197, 94, 0.8);
    }

    .poison-chip {
      padding-left: 10px;
      border-left: 1px solid rgba(34, 197, 94, 0.35);
      min-width: 82px;
    }

    .poison-chip.hidden {
      display: none;
    }

    .poison-chip.danger .meter-badge {
      color: #86efac !important;
      text-shadow: 0 0 10px rgba(74, 222, 128, 0.9);
      animation: poisonPulse 0.6s infinite ease-in-out;
    }

    @keyframes poisonPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.12); }
    }

    /* Altın Kalp, Altın Sayacı, Enerji Kalkanı ve Atılma Yükleri */
    .hearts-gold-group {
      display: flex;
      align-items: center;
      gap: 9px;
      padding-left: 10px;
      border-left: 1px solid var(--glass-border);
    }

    .hearts-box {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .hearts-row {
      display: flex;
      align-items: center;
      gap: 3px;
      line-height: 1;
    }

    .heart-slot {
      font-size: 0.96rem;
      color: rgba(148, 163, 184, 0.28);
      transition: transform 0.2s ease, color 0.2s ease, text-shadow 0.2s ease;
    }

    .heart-slot.filled {
      color: var(--gold);
      text-shadow: 0 0 10px rgba(255, 209, 102, 0.88);
    }

    .heart-slot.pop {
      transform: scale(1.32);
    }

    .gold-chip {
      min-width: 78px;
    }

    .shield-hud-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 8px;
      border-radius: 999px;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      background: rgba(0, 245, 255, 0.14);
      border: 1px solid rgba(0, 245, 255, 0.65);
      color: var(--cyan);
      box-shadow: 0 0 12px rgba(0, 245, 255, 0.24);
      white-space: nowrap;
    }

    .shield-hud-pill.recharging {
      background: rgba(30, 41, 59, 0.65);
      border-color: rgba(148, 163, 184, 0.35);
      color: var(--text-muted);
      box-shadow: none;
    }

    .shield-hud-pill.hidden {
      display: none;
    }

    .dash-pips {
      display: inline-flex;
      align-items: center;
      gap: 3px;
    }

    .dash-pip {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: rgba(148, 163, 184, 0.28);
      border: 1px solid rgba(148, 163, 184, 0.45);
      transition: all 0.15s ease;
    }

    .dash-pip.ready {
      background: var(--cyan);
      border-color: #ffffff;
      box-shadow: 0 0 8px var(--cyan);
    }

    /* Orta Dalga ve Yükseltme Rozetleri Yığını */
    .center-hud-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      flex: 0 1 320px;
    }

    /* Orta Dalga Çubuğu */
    .wave-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      border-radius: 14px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(8px);
      width: 100%;
      min-width: 210px;
      max-width: 310px;
    }

    .wave-tag {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: var(--cyan);
      white-space: nowrap;
    }

    .wave-track {
      flex: 1;
      height: 5px;
      background: rgba(148, 163, 184, 0.2);
      border-radius: 999px;
      overflow: hidden;
    }

    .wave-fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      background: linear-gradient(90deg, #00f5ff, #b55cff, #ffd166);
      box-shadow: 0 0 10px rgba(181, 92, 255, 0.65);
      transition: width 0.1s linear;
    }

    .wave-timer {
      font-size: 0.68rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--text-muted);
      min-width: 26px;
      text-align: right;
    }

    /* Sağ Aksiyon Butonları (pointer-events: auto) */
    .hud-actions {
      display: flex;
      align-items: center;
      gap: 6px;
      pointer-events: auto;
    }

    .btn-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 7px 11px;
      border-radius: 12px;
      border: 1px solid var(--glass-border);
      background: var(--glass-bg);
      backdrop-filter: blur(8px);
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn-pill:hover {
      background: rgba(30, 41, 59, 0.85);
      border-color: rgba(0, 245, 255, 0.5);
      transform: translateY(-1px);
    }

    .btn-pill:active {
      transform: scale(0.96);
    }

    .btn-pill.active-muted {
      color: var(--text-muted);
    }

    .btn-pill svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

    /* Alınan Yükseltme Rozetleri (Üst HUD altında kompakt yüzer) */
    .upgrade-badges {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      flex-wrap: wrap;
    }

    .upg-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 9px;
      border-radius: 999px;
      background: rgba(9, 13, 25, 0.72);
      border: 1px solid rgba(0, 245, 255, 0.35);
      backdrop-filter: blur(6px);
      font-size: 0.66rem;
      font-weight: 700;
      color: #e2e8f0;
      white-space: nowrap;
    }

    .upg-badge .upg-lvl {
      color: var(--gold);
      font-weight: 900;
    }

    .upg-badge.shield-ready {
      border-color: rgba(0, 245, 255, 0.8);
      color: var(--cyan);
    }

    .upg-badge.shield-recharging {
      border-color: rgba(148, 163, 184, 0.35);
      color: var(--text-muted);
    }

    /* =====================================================================
       UYARI ŞERİDİ (ELİT ÇEKİRDEK / ALAN OLAYI)
       ===================================================================== */
    .event-banner {
      position: fixed;
      top: 76px;
      left: 50%;
      transform: translateX(-50%) translateY(-14px);
      padding: 7px 18px;
      border-radius: 999px;
      background: rgba(11, 16, 30, 0.88);
      border: 1px solid rgba(255, 51, 102, 0.75);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      pointer-events: none;
      opacity: 0;
      z-index: 12;
      white-space: nowrap;
      box-shadow: 0 0 24px rgba(255, 51, 102, 0.35);
      transition: opacity 0.22s ease, transform 0.22s ease;
    }

    .event-banner.visible {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .event-banner.violet {
      border-color: rgba(181, 92, 255, 0.8);
      box-shadow: 0 0 24px rgba(181, 92, 255, 0.4);
      color: #e9d5ff;
    }

    .event-banner.orange {
      border-color: rgba(255, 136, 17, 0.8);
      box-shadow: 0 0 24px rgba(255, 136, 17, 0.4);
      color: #ffedd5;
    }

    .event-banner.crimson {
      border-color: rgba(255, 51, 102, 0.85);
      box-shadow: 0 0 26px rgba(255, 51, 102, 0.45);
      color: #ffe4e6;
    }

    .event-banner.cyan {
      border-color: rgba(0, 245, 255, 0.8);
      box-shadow: 0 0 24px rgba(0, 245, 255, 0.4);
      color: #cffafe;
    }

    .event-banner.gold {
      border-color: rgba(255, 209, 102, 0.88);
      box-shadow: 0 0 28px rgba(255, 209, 102, 0.45);
      color: #fef3c7;
    }

    .event-banner.emerald {
      border-color: rgba(34, 197, 94, 0.88);
      box-shadow: 0 0 28px rgba(34, 197, 94, 0.48);
      color: #dcfce7;
    }

    kbd {
      display: inline-block;
      padding: 1px 5px;
      border-radius: 5px;
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid rgba(148, 163, 184, 0.25);
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.64rem;
      font-weight: 700;
    }

    .floating-dash-btn {
      position: fixed;
      bottom: 18px;
      right: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 9px 15px 9px 10px;
      border-radius: 999px;
      border: 1px solid rgba(0, 245, 255, 0.6);
      background: linear-gradient(135deg, rgba(0, 180, 216, 0.32), rgba(9, 13, 25, 0.84));
      backdrop-filter: blur(8px);
      color: var(--cyan);
      font-family: inherit;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      cursor: pointer;
      pointer-events: auto;
      z-index: 10;
      box-shadow: 0 0 20px rgba(0, 245, 255, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.2);
      transition: transform 0.14s ease, opacity 0.14s ease, box-shadow 0.14s ease;
    }

    .dash-ring-wrap {
      position: relative;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .dash-ring-svg {
      width: 28px;
      height: 28px;
      transform: rotate(-90deg);
    }

    .dash-ring-bg {
      fill: none;
      stroke: rgba(148, 163, 184, 0.25);
      stroke-width: 3;
    }

    .dash-ring-fg {
      fill: none;
      stroke: var(--cyan);
      stroke-width: 3;
      stroke-linecap: round;
      stroke-dasharray: 69.115;
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.06s linear;
    }

    .dash-ring-icon {
      position: absolute;
      font-size: 0.78rem;
      line-height: 1;
    }

    .btn-dash-col {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 3px;
    }

    .floating-dash-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 28px rgba(0, 245, 255, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }

    .floating-dash-btn:active {
      transform: scale(0.96);
    }

    .floating-dash-btn.on-cooldown {
      opacity: 0.62;
      border-color: rgba(148, 163, 184, 0.35);
      color: var(--text-muted);
      box-shadow: none;
    }

    .floating-hints {
      position: fixed;
      bottom: 18px;
      left: 18px;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      border-radius: 12px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(8px);
      font-size: 0.7rem;
      color: var(--text-muted);
      pointer-events: none;
      z-index: 10;
    }

    /* =====================================================================
       OVERLAY VE MODAL KARTLARI
       ===================================================================== */
    .overlay {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px;
      background: rgba(5, 8, 17, 0.78);
      backdrop-filter: blur(8px);
      z-index: 30;
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    .overlay.hidden {
      display: none;
      opacity: 0;
      pointer-events: none;
    }

    .modal-card {
      width: 100%;
      max-width: 560px;
      max-height: 92vh;
      overflow-y: auto;
      padding: 26px 24px 22px;
      border-radius: 22px;
      background: linear-gradient(170deg, rgba(16, 23, 42, 0.96), rgba(8, 12, 24, 0.98));
      border: 1px solid rgba(0, 245, 255, 0.25);
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.72), 0 0 40px rgba(0, 245, 255, 0.12);
      text-align: center;
    }

    .modal-card.wide {
      max-width: 720px;
    }

    .game-title {
      font-size: clamp(2rem, 5vw, 2.75rem);
      font-weight: 900;
      letter-spacing: 0.16em;
      background: linear-gradient(135deg, #ffffff 0%, #00f5ff 50%, #38ef7d 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 6px;
    }

    .game-subtitle {
      font-size: 0.84rem;
      color: var(--text-muted);
      margin-bottom: 14px;
    }

    .start-highscore-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 14px;
      margin-bottom: 16px;
      border-radius: 999px;
      background: rgba(255, 209, 102, 0.14);
      border: 1px solid rgba(255, 209, 102, 0.42);
      color: var(--gold);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.06em;
    }

    .guide-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-bottom: 16px;
      text-align: left;
    }

    .guide-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 11px 12px;
      border-radius: 13px;
      background: rgba(15, 23, 42, 0.72);
      border: 1px solid var(--glass-border);
    }

    .guide-item strong {
      font-size: 0.76rem;
      color: var(--cyan);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .guide-item span {
      font-size: 0.74rem;
      color: #cbd5e1;
      line-height: 1.38;
    }

    .legend-row {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 18px;
    }

    .legend-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 600;
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid var(--glass-border);
      color: #e2e8f0;
    }

    .chip-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .btn-primary {
      width: 100%;
      padding: 13px 24px;
      border: none;
      border-radius: 14px;
      background: linear-gradient(135deg, #00d2ff 0%, #00f5ff 55%, #38ef7d 100%);
      color: #061019;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 8px 28px rgba(0, 245, 255, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.5);
      transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 34px rgba(0, 245, 255, 0.5);
      filter: brightness(1.05);
    }

    .btn-primary:active {
      transform: scale(0.98);
    }

    .btn-secondary {
      width: 100%;
      margin-top: 10px;
      padding: 11px 20px;
      border-radius: 14px;
      border: 1px solid var(--glass-border);
      background: rgba(30, 41, 59, 0.65);
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn-secondary:hover {
      background: rgba(51, 65, 85, 0.85);
      border-color: rgba(148, 163, 184, 0.42);
    }

    /* =====================================================================
       ROGUELITE YÜKSELTME KARTLARI EKRANI
       ===================================================================== */
    .upgrade-header-tag {
      display: inline-block;
      padding: 4px 12px;
      margin-bottom: 8px;
      border-radius: 999px;
      background: rgba(181, 92, 255, 0.18);
      border: 1px solid rgba(181, 92, 255, 0.55);
      color: #e9d5ff;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .upgrade-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin: 18px 0 12px;
    }

    .upgrade-card {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
      padding: 18px 14px 16px;
      border-radius: 16px;
      background: linear-gradient(175deg, rgba(22, 31, 56, 0.95), rgba(10, 14, 27, 0.98));
      border: 1px solid rgba(0, 245, 255, 0.28);
      color: var(--text-main);
      font-family: inherit;
      cursor: pointer;
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
      box-shadow: 0 10px 26px rgba(0, 0, 0, 0.45);
    }

    .upgrade-card:hover,
    .upgrade-card:focus-visible {
      transform: translateY(-5px);
      border-color: var(--card-accent, var(--cyan));
      box-shadow: 0 14px 36px rgba(0, 0, 0, 0.6), 0 0 24px var(--card-glow, rgba(0, 245, 255, 0.35));
      outline: none;
    }

    .upgrade-card:active {
      transform: translateY(-1px) scale(0.98);
    }

    .card-key-pill {
      position: absolute;
      top: 10px;
      left: 10px;
      width: 24px;
      height: 24px;
      border-radius: 7px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(148, 163, 184, 0.35);
      color: var(--text-muted);
      font-size: 0.72rem;
      font-weight: 800;
    }

    .card-lvl-pill {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 2px 8px;
      border-radius: 999px;
      background: rgba(255, 209, 102, 0.15);
      border: 1px solid rgba(255, 209, 102, 0.45);
      color: var(--gold);
      font-size: 0.66rem;
      font-weight: 800;
    }

    .card-icon {
      width: 50px;
      height: 50px;
      margin-top: 12px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.55rem;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid var(--card-accent, var(--cyan));
      box-shadow: 0 0 18px var(--card-glow, rgba(0, 245, 255, 0.25));
    }

    .card-title {
      font-size: 0.98rem;
      font-weight: 800;
      color: #ffffff;
    }

    .card-desc {
      font-size: 0.76rem;
      line-height: 1.45;
      color: #cbd5e1;
      flex: 1;
    }

    .card-cta {
      margin-top: 4px;
      padding: 6px 12px;
      width: 100%;
      border-radius: 9px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--card-accent, var(--cyan));
    }

    /* =====================================================================
       OYUN BİTTİ İSTATİSTİKLERİ
       ===================================================================== */
    .record-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 14px;
      margin-bottom: 10px;
      border-radius: 999px;
      background: rgba(255, 209, 102, 0.16);
      border: 1px solid rgba(255, 209, 102, 0.55);
      color: var(--gold);
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      box-shadow: 0 0 20px rgba(255, 209, 102, 0.25);
      animation: pulseBadge 1.5s infinite ease-in-out;
    }

    .record-badge.hidden { display: none; }

    @keyframes pulseBadge {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    .gameover-title {
      font-size: 1.85rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      color: var(--crimson);
      text-shadow: 0 0 24px rgba(255, 51, 102, 0.45);
      margin-bottom: 4px;
    }

    .gameover-sub {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .stats-summary {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 9px;
      margin-bottom: 18px;
    }

    .summary-box {
      padding: 11px 8px;
      border-radius: 12px;
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid var(--glass-border);
    }

    .summary-box .label {
      font-size: 0.64rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 3px;
    }

    .summary-box .val {
      font-size: 1.25rem;
      font-weight: 900;
      font-variant-numeric: tabular-nums;
      color: var(--text-main);
    }

    .summary-box.gold .val { color: var(--gold); }
    .summary-box.cyan .val { color: var(--cyan); }
    .summary-box.orange .val { color: var(--orange); }
    .summary-box.violet .val { color: #d8b4fe; }

    .shortcut-note {
      margin-top: 10px;
      font-size: 0.72rem;
      color: var(--text-muted);
    }

    /* =====================================================================
       MOBİL VE KÜÇÜK EKRAN UYUMLULUĞU
       ===================================================================== */
    @media (max-width: 760px) {
      .floating-hud {
        top: 10px;
        left: 10px;
        right: 10px;
        gap: 5px;
      }

      .hud-brand {
        display: none;
      }

      .hud-cluster {
        padding: 5px 9px;
        gap: 8px;
      }

      .stat-chip {
        min-width: 46px;
      }

      .stat-value {
        font-size: 0.88rem;
      }

      .meter-chip {
        min-width: 68px;
      }

      .wave-pill {
        min-width: 150px;
        padding: 5px 9px;
      }

      .btn-pill {
        padding: 6px 9px;
        font-size: 0.68rem;
      }

      .floating-hints {
        display: none;
      }

      .floating-dash-btn {
        bottom: 16px;
        right: 14px;
        padding: 10px 16px 10px 11px;
        font-size: 0.8rem;
      }

      .hearts-gold-group {
        padding-left: 7px;
        gap: 6px;
      }

      .gold-chip {
        min-width: 64px;
      }

      .upgrade-cards-grid {
        grid-template-columns: 1fr;
        gap: 9px;
      }

      .upgrade-card {
        flex-direction: row;
        text-align: left;
        padding: 12px 12px 12px 42px;
        gap: 12px;
      }

      .card-icon {
        margin-top: 0;
        width: 42px;
        height: 42px;
        font-size: 1.3rem;
        flex-shrink: 0;
      }

      .card-cta {
        display: none;
      }

      .stats-summary {
        grid-template-columns: repeat(2, 1fr);
      }

      .guide-grid {
        grid-template-columns: 1fr;
      }

      .modal-card {
        padding: 18px 14px;
      }
    }
  </style>
</head>
<body>
  <!-- =================================================================
       TAM EKRAN OYUN ARENASI CANVAS (100vw x 100vh)
       ================================================================= -->
  <canvas id="gameCanvas"></canvas>

  <!-- =================================================================
       ÜST YÜZER HUD (YARI SAYDAM, ALANI DARALTMAZ)
       ================================================================= -->
  <header class="floating-hud" aria-label="Oyun Göstergeleri">
    <div class="hud-row">
      <!-- Sol: Skor, Rekor, Kombo, Altın Kalp, Altın Sayacı, Kalkan -->
      <div class="hud-cluster">
        <div class="hud-brand">
          <span class="brand-dot"></span>
          <span class="brand-name">KIVILCIM</span>
        </div>

        <div class="stat-chip">
          <span class="stat-label">Skor</span>
          <span id="hudScore" class="stat-value">0</span>
        </div>

        <div class="stat-chip">
          <span class="stat-label">Rekor</span>
          <span id="hudHighScore" class="stat-value gold">0</span>
        </div>

        <div class="meter-chip">
          <div class="meter-head">
            <span class="stat-label">Kombo</span>
            <span id="hudComboText" class="meter-badge" style="color: var(--gold);">x1</span>
          </div>
          <div class="meter-track">
            <div id="hudComboBar" class="meter-fill combo"></div>
          </div>
        </div>

        <div class="hearts-gold-group">
          <div class="hearts-box" title="Altın Kalpler (Maksimum 3 Can)">
            <span class="stat-label">Altın Kalp</span>
            <div id="hudHeartsRow" class="hearts-row">
              <span class="heart-slot" data-heart="0">♥</span>
              <span class="heart-slot" data-heart="1">♥</span>
              <span class="heart-slot" data-heart="2">♥</span>
            </div>
          </div>

          <div class="meter-chip gold-chip" title="Altın Kalp gereksinimi: 1. Kalp 15, 2. Kalp 20, 3. Kalp 25 Altın">
            <div class="meter-head">
              <span class="stat-label">Altın</span>
              <span id="hudGoldText" class="meter-badge" style="color: var(--gold);">🪙 0/15</span>
            </div>
            <div class="meter-track">
              <div id="hudGoldBar" class="meter-fill gold-progress"></div>
            </div>
          </div>
        </div>

        <div class="meter-chip">
          <div class="meter-head">
            <span class="stat-label">Atılma</span>
            <div id="hudDashPips" class="dash-pips" aria-label="Atılma Yükleri">
              <span class="dash-pip ready"></span>
            </div>
            <span id="hudDashText" class="meter-badge" style="color: var(--cyan);">HAZIR</span>
          </div>
          <div class="meter-track">
            <div id="hudDashBar" class="meter-fill dash" style="width: 100%;"></div>
          </div>
        </div>

        <div id="hudPoisonChip" class="meter-chip poison-chip hidden" title="10. Turdan itibaren zehir atmosferi periyodik hasar verir">
          <div class="meter-head">
            <span class="stat-label" style="color: #4ade80;">Zehir</span>
            <span id="hudPoisonText" class="meter-badge" style="color: #4ade80;">☠️ 35s</span>
          </div>
          <div class="meter-track">
            <div id="hudPoisonBar" class="meter-fill poison" style="width: 100%;"></div>
          </div>
        </div>
      </div>

      <!-- Orta: 35 Saniyelik Dalga Çubuğu ve Aktif Yükseltme Rozetleri -->
      <div class="center-hud-stack">
        <div class="wave-pill" title="Sonraki yükseltme kartına kalan süre">
          <span id="hudWaveLabel" class="wave-tag">DALGA 1</span>
          <div class="wave-track">
            <div id="hudWaveBar" class="wave-fill"></div>
          </div>
          <span id="hudWaveTimer" class="wave-timer">35s</span>
        </div>
        <div id="upgradeBadges" class="upgrade-badges"></div>
      </div>

      <!-- Sağ: Duraklat & Ses Butonları -->
      <div class="hud-actions">
        <button id="btnPause" class="btn-pill" type="button" title="Duraklat (P / Esc)">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="6" y="4" width="4" height="16" rx="1.5"></rect>
            <rect x="14" y="4" width="4" height="16" rx="1.5"></rect>
          </svg>
          <span id="pauseBtnText">Duraklat</span>
        </button>

        <button id="btnSound" class="btn-pill" type="button" title="Sesi Aç / Kapat">
          <svg id="soundIconOn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
          </svg>
          <svg id="soundIconOff" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
          <span id="soundBtnText">Ses: Açık</span>
        </button>
      </div>
    </div>
  </header>

  <!-- DİNAMİK OLAY / ELİT ÇEKİRDEK UYARI ŞERİDİ -->
  <div id="eventBanner" class="event-banner" aria-live="polite"></div>

  <!-- ALT SOL KONTROL İPUÇLARI (SADECE MASAÜSTÜ, ALANI DARALTMAZ) -->
  <div class="floating-hints" aria-hidden="true">
    <span><kbd>WASD</kbd> / <kbd>↑↓←→</kbd> Hareket</span>
    <span>•</span>
    <span><kbd>Boşluk</kbd> / <kbd>Shift</kbd> / <kbd>Sol Tık</kbd> Atılma</span>
    <span>•</span>
    <span><kbd>P</kbd> Duraklat</span>
  </div>

  <!-- ALT SAĞ YÜZER ATILMA BUTONU (CANLI DOLUM HALKASI & YÜK NOKTALARI) -->
  <button id="btnDashAction" class="floating-dash-btn" type="button" aria-label="Atılma">
    <span class="dash-ring-wrap" aria-hidden="true">
      <svg class="dash-ring-svg" viewBox="0 0 28 28">
        <circle class="dash-ring-bg" cx="14" cy="14" r="11"></circle>
        <circle id="btnDashRingProgress" class="dash-ring-fg" cx="14" cy="14" r="11"></circle>
      </svg>
      <span class="dash-ring-icon">⚡</span>
    </span>
    <span class="btn-dash-col">
      <span>ATILMA</span>
      <span id="btnDashPips" class="dash-pips">
        <span class="dash-pip ready"></span>
      </span>
    </span>
  </button>

  <!-- =================================================================
       BAŞLANGIÇ EKRANI
       ================================================================= -->
  <section id="startOverlay" class="overlay">
    <div class="modal-card">
      <h1 class="game-title">KIVILCIM</h1>
      <p class="game-subtitle">Tam Ekran Neon Hayatta Kalma &amp; Roguelite Arenası</p>

      <div class="start-highscore-pill">
        <span>★ EN YÜKSEK SKOR:</span>
        <span id="startHighScore">0</span>
      </div>

      <div class="guide-grid">
        <div class="guide-item">
          <strong><span>◈</span> Hareket &amp; Atılma</strong>
          <span><strong>WASD</strong> / <strong>Ok Tuşları</strong> (mobil: sürükle). <strong>Boşluk / Shift / Sol Tık</strong> ile dokunulmaz atılma yap.</span>
        </div>
        <div class="guide-item">
          <strong><span>♥</span> Altın Kalp (+1 Can)</strong>
          <span><strong>15 / 20 / 25 Altın</strong> topladığında arenada bir <strong>Altın Kalp</strong> belirir (maksimum <strong>3 kalp</strong>).</span>
        </div>
        <div class="guide-item">
          <strong><span>⚡</span> Kıl Payı &amp; Yemleme</strong>
          <span>Sıyırarak Atılmanı <strong>anında sıfırla (+25)</strong>; turuncu <strong>Mızrakları</strong> diğer düşmanlara yemle (+60)!</span>
        </div>
        <div class="guide-item">
          <strong><span>✦</span> 9 Roguelite Yükseltme</strong>
          <span>Her <strong>35 sn</strong>'de 3 karttan seç: <em>Çift Atlama, Altın Şoku, Şaşırtma, Plazma İzi, Kalkan</em> ve fazlası!</span>
        </div>
      </div>

      <div class="legend-row">
        <span class="legend-chip"><span class="chip-dot" style="background: var(--gold); box-shadow: 0 0 8px var(--gold);"></span>Altın Kalp</span>
        <span class="legend-chip"><span class="chip-dot" style="background: var(--crimson); box-shadow: 0 0 8px var(--crimson);"></span>Takipçi</span>
        <span class="legend-chip"><span class="chip-dot" style="background: var(--orange); box-shadow: 0 0 8px var(--orange);"></span>Mızrak</span>
        <span class="legend-chip"><span class="chip-dot" style="background: var(--violet); box-shadow: 0 0 8px var(--violet);"></span>Seken</span>
        <span class="legend-chip"><span class="chip-dot" style="background: var(--cyan); box-shadow: 0 0 8px var(--cyan);"></span>Şok Küresi</span>
        <span class="legend-chip"><span class="chip-dot" style="background: #ff2255; box-shadow: 0 0 8px #ff2255;"></span>Elit Çekirdek</span>
      </div>

      <button id="btnStart" class="btn-primary" type="button">Başla</button>
      <p class="shortcut-note">Başlamak için <strong>Boşluk</strong> veya <strong>Enter</strong> tuşuna basabilirsin</p>
    </div>
  </section>

  <!-- =================================================================
       DALGA SONU YÜKSELTME KARTLARI EKRANI
       ================================================================= -->
  <section id="upgradeOverlay" class="overlay hidden">
    <div class="modal-card wide">
      <div id="upgradeWaveTag" class="upgrade-header-tag">DALGA 1 TAMAMLANDI</div>
      <h2 class="game-title" style="font-size: 1.75rem; margin-bottom: 4px;">YÜKSELTME SEÇ</h2>
      <p class="gameover-sub" style="margin-bottom: 4px;">Arenaya hükmetmek için 3 neon karttan birini seç</p>

      <div id="upgradeCardsContainer" class="upgrade-cards-grid"></div>

      <p class="shortcut-note">Hızlı seçim için klavyeden <kbd>1</kbd>, <kbd>2</kbd> veya <kbd>3</kbd> tuşuna basabilirsin</p>
    </div>
  </section>

  <!-- =================================================================
       DURAKLATMA EKRANI
       ================================================================= -->
  <section id="pauseOverlay" class="overlay hidden">
    <div class="modal-card" style="max-width: 390px;">
      <h2 class="game-title" style="font-size: 1.8rem; margin-bottom: 6px;">DURAKLATILDI</h2>
      <p class="gameover-sub">Nefes al, arena seni bekliyor.</p>
      <button id="btnResume" class="btn-primary" type="button">Devam Et</button>
      <button id="btnRestartFromPause" class="btn-secondary" type="button">Yeniden Başlat</button>
      <p class="shortcut-note">Devam etmek için <kbd>P</kbd> veya <kbd>Esc</kbd></p>
    </div>
  </section>

  <!-- =================================================================
       OYUN BİTTİ EKRANI
       ================================================================= -->
  <section id="gameOverOverlay" class="overlay hidden">
    <div class="modal-card" style="max-width: 480px;">
      <div id="newRecordBadge" class="record-badge hidden">★ YENİ REKOR! ★</div>
      <h2 class="gameover-title">OYUN BİTTİ</h2>
      <p class="gameover-sub">Kıvılcım söndü, ama reflekslerin daha da keskinleşti.</p>

      <div class="stats-summary">
        <div class="summary-box gold">
          <div class="label">Skor</div>
          <div class="val" id="finalScore">0</div>
        </div>
        <div class="summary-box">
          <div class="label">En Yüksek</div>
          <div class="val" id="finalHighScore" style="color: #fde68a;">0</div>
        </div>
        <div class="summary-box violet">
          <div class="label">Dalga</div>
          <div class="val" id="finalWave">1</div>
        </div>
        <div class="summary-box gold">
          <div class="label">Toplanan Altın</div>
          <div class="val" id="finalGold">0</div>
        </div>
        <div class="summary-box orange">
          <div class="label">Yemleme</div>
          <div class="val" id="finalBaits">0</div>
        </div>
        <div class="summary-box cyan">
          <div class="label">Kıl Payı</div>
          <div class="val" id="finalGrazes">0</div>
        </div>
      </div>

      <button id="btnRestart" class="btn-primary" type="button">TEKRAR OYNA</button>
      <p class="shortcut-note">Hızlı tekrar için <kbd>Enter</kbd> veya <kbd>Boşluk</kbd></p>
    </div>
  </section>

  <script>
    /**
     * =========================================================================
     * KIVILCIM — Tam Ekran (100vw x 100vh) 2D Neon Hayatta Kalma & Roguelite
     * - Kusursuz HiDPI / Retina ölçekleme (her resize & her kare setTransform)
     * - Tüm 5 geliştirme eksiksiz entegre:
     *   1) Yemleme (Turuncu Mızrak -> Takipçi/Seken +60, Elit Çekirdek -1 can)
     *   2) Kıl Payı (+25 puan + ANINDA Atılma Sıfırlama)
     *   3) 35 Saniyelik Dalga & 6 Yetenekli Roguelite Kart Sistemi
     *   4) Çekim Girdabı, Lazer Bariyeri ve 2. Dalgadan itibaren Elit Çekirdek
     *   5) Komboya Bağlı Dinamik BPM Ritim, Kenar Parlaması ve Hitstop
     * =========================================================================
     */
    (function () {
      'use strict';

      /* -----------------------------------------------------------------------
         1. SABİTLER, RENKLER VE YÜKSELTME HAVUZU
         ----------------------------------------------------------------------- */
      const STORAGE_HIGH_SCORE = 'kivilcim_high_score_v2';
      const STORAGE_MUTE = 'kivilcim_sound_muted_v2';

      const COLORS = {
        bg: '#06070d',
        grid: 'rgba(148, 163, 184, 0.055)',
        borderNeon: 'rgba(0, 245, 255, 0.34)',
        player: '#00f5ff',
        cyan: '#00f5ff',
        playerCore: '#ffffff',
        gold: '#ffd166',
        goldBright: '#fff3b0',
        crimson: '#ff3366',
        orange: '#ff8811',
        violet: '#b55cff',
        shock: '#00f5ff',
        emerald: '#38ef7d',
        elite: '#ff1e56',
        poison: '#22c55e',
        poisonBright: '#4ade80'
      };

      const CONFIG = {
        arenaMargin: 10, // Kenarlardaki ince neon sınır boşluğu (px)
        playerRadius: 11,
        basePlayerAccel: 2350,
        basePlayerMaxSpeed: 365,
        playerFriction: 7.4,
        dashSpeed: 1050,
        dashDuration: 0.16,
        dashInvulnDuration: 0.26,
        baseDashCooldown: 1.45,
        baseMagnetRadius: 52,
        comboDuration: 4.5,
        maxCombo: 5,
        waveDuration: 35.0,
        shardRadius: 10,
        shockOrbRadius: 13,
        goldPerHeartSteps: [15, 20, 25], // 1. kalp: 15, 2. kalp: 20, 3. kalp: 25 altın
        maxGoldenHearts: 3,
        goldenHeartRadius: 13,
        baseGrazeMargin: 36,
        baseGrazePoints: 25,
        baitPoints: 60,
        vortexRadius: 195,
        vortexPlayerPull: 600, // Oyuncuyu hissedilir şekilde çeker
        vortexEnemyPull: 850,  // Düşmanları daha güçlü çeker
        laserWarningTime: 1.8,
        laserActiveTime: 1.15,
        poisonStartWave: 10,
        poisonBaseInterval: 35,
        poisonMinInterval: 5,
        eliteBaseHp: 4,
        eliteHpWaveStep: 5 // Her 5 turda bir Elit Çekirdek canı +1 artar
      };

      /* =====================================================================
