        });
        spawnParticles(pos.x, pos.y, COLORS.elite, 26, 80, 260, 3, 5.5);
        showBanner(`☠️ ELİT ÇEKİRDEK (${hp} CAN) ARENAYA GİRDİ!`, 'crimson', 2.7);
        Sound.playTone(130, 0.38, 'sawtooth', 0.11, 260);
      }

      /* -----------------------------------------------------------------------
         9. ATILMA, ŞOK DALGASI, KIL PAYI & HASAR SİSTEMİ
         ----------------------------------------------------------------------- */
      function triggerDash(preferredDirX = null, preferredDirY = null) {
        if (state.mode !== 'playing') return;
        const p = state.player;
        if (p.dashCharges <= 0 || p.dashChainLock > 0) return;

        let dx = preferredDirX;
        let dy = preferredDirY;

        if (dx === null || dy === null) {
          const input = getMovementInput();
          if (Math.hypot(input.x, input.y) > 0.1) {
            dx = input.x;
            dy = input.y;
          } else if (Math.hypot(p.vx, p.vy) > 25) {
            const spd = Math.hypot(p.vx, p.vy);
            dx = p.vx / spd;
            dy = p.vy / spd;
          } else {
            dx = p.facingX || 1;
            dy = p.facingY || 0;
          }
        }

        const len = Math.hypot(dx, dy) || 1;
        dx /= len;
        dy /= len;

        p.facingX = dx;
        p.facingY = dy;
        p.vx = dx * CONFIG.dashSpeed;
        p.vy = dy * CONFIG.dashSpeed;
        p.dashTimer = CONFIG.dashDuration;
        p.dashInvulnTimer = CONFIG.dashInvulnDuration;
        p.dashChainLock = 0.16;
        p.dashCharges--;

        if (p.dashCooldownTimer <= 0) {
          p.dashCooldownTimer = getDashCooldown();
        }

        spawnParticles(p.x, p.y, COLORS.cyan, 14, 60, 220, 2, 4.5);
        Sound.dash();

        UpgradeSystem.emit('onDash', {
          x: p.x,
          y: p.y,
          dx,
          dy,
          chargesLeft: p.dashCharges
        });

        updateHUDMeters();
      }

      function resetDashInstant() {
        const p = state.player;
        const maxCharges = getMaxDashCharges();
        p.dashCharges = maxCharges;
        p.dashCooldownTimer = 0;
        updateHUDMeters();
      }

      function awardNearMiss(x, y, targetEntity = null) {
        state.nearMisses++;
        const pts = getGrazePoints();
        addScore(pts, false);
        resetDashInstant();
        addFloatingText(x, y - 16, `KIL PAYI! +${pts} ⚡`, COLORS.cyan, 13);
        spawnParticles(state.player.x, state.player.y, COLORS.cyan, 10, 70, 180, 1.8, 3.5);
        Sound.nearMiss();

        UpgradeSystem.emit('onNearMiss', targetEntity);
      }

      function damageEliteCore(core, dmg, hitX, hitY, sourceLabel = '') {
        core.hp -= dmg;
        core.flashTimer = 0.18;
        addHitstop(0.045);
        addScreenShake(7, 0.22);
        spawnParticles(hitX, hitY, COLORS.elite, 18, 90, 280, 2.5, 5);

        if (core.hp <= 0) {
          const bonus = 200 * state.combo;
          addScore(bonus);
          addHitstop(0.075);
          addScreenShake(12, 0.32);
          spawnParticles(core.x, core.y, COLORS.elite, 42, 100, 380, 3, 6.5);
          spawnParticles(core.x, core.y, COLORS.gold, 24, 80, 260, 2.5, 5);
          addFloatingText(core.x, core.y - 10, `ELİT İMHA! +${bonus}`, COLORS.goldBright, 18);
          Sound.eliteDestroy();
          for (let i = 0; i < 3; i++) {
            const ang = (Math.PI * 2 * i) / 3 + Math.random();
            state.shards.push({
              x: clamp(core.x + Math.cos(ang) * 32, 30, viewWidth - 30),
              y: clamp(core.y + Math.sin(ang) * 32, 60, viewHeight - 30),
              radius: CONFIG.shardRadius,
              pulse: Math.random() * Math.PI * 2,
              life: 16
            });
          }
          return true;
        } else {
          addFloatingText(
            core.x,
            core.y - core.radius - 12,
            `${sourceLabel ? sourceLabel + ' ' : ''}-1 CAN (${core.hp}/${core.maxHp})`,
            '#fda4af',
            14
          );
          Sound.eliteHit();
          return false;
        }
      }

      function triggerShockwave(x, y, baseRadius = 230, color = COLORS.cyan, isGold = false, silentHitstop = false, sourceTag = 'orb') {
        const radius = getShockRadius(baseRadius);
        state.shockwaves.push({
          x,
          y,
          radius: 16,
          maxRadius: radius,
          color,
          alpha: 1
        });

        if (!silentHitstop) {
          addHitstop(isGold ? 0.04 : 0.055);
          addScreenShake(isGold ? 7 : 10, 0.24);
          Sound.shockwave(isGold);
        }

        let cleared = 0;
        for (let i = state.enemies.length - 1; i >= 0; i--) {
          const e = state.enemies[i];
          if (dist(x, y, e.x, e.y) <= radius + e.radius) {
            spawnParticles(e.x, e.y, color, 12, 70, 240, 2, 4.5);
            state.enemies.splice(i, 1);
            cleared++;
          }
        }

        for (let i = state.eliteProjectiles.length - 1; i >= 0; i--) {
          const pr = state.eliteProjectiles[i];
          if (dist(x, y, pr.x, pr.y) <= radius + pr.radius) {
            spawnParticles(pr.x, pr.y, color, 5, 40, 120, 1.5, 3);
            state.eliteProjectiles.splice(i, 1);
          }
        }

        let eliteHits = 0;
        for (let i = state.eliteCores.length - 1; i >= 0; i--) {
          const c = state.eliteCores[i];
          if (dist(x, y, c.x, c.y) <= radius + c.radius) {
            eliteHits++;
            const dead = damageEliteCore(c, 1, c.x, c.y, isGold ? 'ALTIN ŞOKU' : 'ŞOK');
            if (dead) state.eliteCores.splice(i, 1);
          }
        }

        if (cleared > 0) {
          const bonus = cleared * 25 * state.combo;
          addScore(bonus);
          addFloatingText(
            x,
            y - 22,
            `${isGold ? 'ALTIN ŞOKU!' : 'ŞOK DALGASI!'} +${bonus}`,
            color,
            15
          );
        } else if (isGold) {
          addFloatingText(x, y - 22, '💥 ALTIN ŞOKU!', COLORS.goldBright, 14);
        }

        UpgradeSystem.emit('onShockwave', {
          x,
          y,
          radius,
          isGold,
          sourceTag,
          cleared,
          eliteHits
        });
      }
      function handlePlayerHit(ignoreDashInvuln = false) {
        const p = state.player;
        if (p.hurtInvulnTimer > 0) return;
        if (!ignoreDashInvuln && p.dashInvulnTimer > 0) return;

        // 1. Öncelik: Yükseltme Hook'ları (ör. Enerji Kalkanı -> event.prevented = true)
        const dmgEvent = { prevented: false };
        UpgradeSystem.emit('onTakeDamage', dmgEvent);
        if (dmgEvent.prevented) {
          updateHUDMeters();
          return;
        }

        // 2. Öncelik: Altın Kalp (+1 Can)
        if (state.goldenHearts > 0) {
          state.goldenHearts--;
          p.hurtInvulnTimer = 1.5;
          addHitstop(0.07);
          addScreenShake(12, 0.32);
          Sound.heartBreak();
          triggerShockwave(p.x, p.y, 210, COLORS.gold, true, true, 'heart_break');
          spawnParticles(p.x, p.y, COLORS.gold, 28, 90, 290, 2.5, 5.5);
          addFloatingText(p.x, p.y - 26, '💔 ALTIN KALP KORUDU!', COLORS.goldBright, 16);

          // Can kaybı sonrası yeni eşik (örn. 25 -> 20) aşıldıysa hemen Altın Kalp oluştur
          trySpawnGoldenHeartIfReady();
          updateHUDMeters();
          return;
        }

        // 3. Öncelik: Oyun Bitti
        triggerGameOver();
      }

      /* -----------------------------------------------------------------------
         10. DALGA & ROGUELITE YÜKSELTME KARTLARI
         ----------------------------------------------------------------------- */
      function openUpgradeSelection() {
        state.mode = 'upgrade';
        Sound.upgradeAppear();

        const available = UpgradeSystem.getAvailableUpgrades();
        if (available.length === 0) {
          const bonus = 300 * state.wave;
          addScore(bonus);
          addFloatingText(state.player.x, state.player.y - 24, `MAKSİMUM GÜÇ! +${bonus}`, COLORS.goldBright, 17);
          state.wave++;
          state.waveTimer = CONFIG.waveDuration;
          state.mode = 'playing';
          onWaveEntered();
          updateHUDMeters();
          return;
        }

        const shuffled = [...available].sort(() => Math.random() - 0.5);
        const choices = shuffled.slice(0, Math.min(3, shuffled.length));
        state.pendingUpgradeChoices = choices;

        upgradeWaveTag.textContent = `DALGA ${state.wave} TAMAMLANDI`;
        upgradeCardsContainer.innerHTML = '';

        choices.forEach((upg, index) => {
          const currLvl = UpgradeSystem.getLevel(upg.id);
          const maxLvl = upg.maxLevel || 1;
          const descText = typeof upg.desc === 'function' ? upg.desc(currLvl) : upg.desc;
          const accent = upg.color || COLORS.cyan;
          const glow = upg.glow || 'rgba(0, 245, 255, 0.35)';

          const card = document.createElement('button');
          card.type = 'button';
          card.className = 'upgrade-card';
          card.style.setProperty('--card-accent', accent);
          card.style.setProperty('--card-glow', glow);

          card.innerHTML = `
            <span class="card-key-pill">${index + 1}</span>
            <span class="card-lvl-pill">Sv.${currLvl + 1}/${maxLvl}</span>
            <div class="card-icon">${upg.icon}</div>
            <div class="card-title">${upg.name}</div>
            <div class="card-desc">${descText}</div>
            <div class="card-cta">SEÇ (${index + 1})</div>
          `;

          card.addEventListener('click', () => selectUpgrade(index));
          upgradeCardsContainer.appendChild(card);
        });

        upgradeOverlay.classList.remove('hidden');
      }

      function selectUpgrade(index) {
        if (state.mode !== 'upgrade') return;
        const chosen = state.pendingUpgradeChoices[index];
        if (!chosen) return;

        UpgradeSystem.acquire(chosen.id);
        Sound.upgradePick();

        upgradeOverlay.classList.add('hidden');
        state.pendingUpgradeChoices = [];
        state.wave++;
        state.waveTimer = CONFIG.waveDuration;
        state.player.hurtInvulnTimer = Math.max(state.player.hurtInvulnTimer, 1.0);
        state.mode = 'playing';

        onWaveEntered();
        renderUpgradeBadges();
        updateHUDMeters();
        addFloatingText(state.player.x, state.player.y - 26, `${chosen.icon} ${chosen.name.toUpperCase()}!`, chosen.color || COLORS.cyan, 16);
      }

      /* -----------------------------------------------------------------------
         11. OYUN DÖNGÜSÜ GÜNCELLEMELERİ (PHYSICS & AI)
         ----------------------------------------------------------------------- */
      function getMovementInput() {
        let ix = 0;
        let iy = 0;
        if (keys['KeyW'] || keys['ArrowUp']) iy -= 1;
        if (keys['KeyS'] || keys['ArrowDown']) iy += 1;
        if (keys['KeyA'] || keys['ArrowLeft']) ix -= 1;
        if (keys['KeyD'] || keys['ArrowRight']) ix += 1;

        if (pointer.active) {
          const dx = pointer.currX - pointer.originX;
          const dy = pointer.currY - pointer.originY;
          const d = Math.hypot(dx, dy);
          if (d > 8) {
            const strength = clamp(d / 55, 0.25, 1);
            ix += (dx / d) * strength;
            iy += (dy / d) * strength;
          }
        }

        const len = Math.hypot(ix, iy);
        if (len > 1) {
          ix /= len;
          iy /= len;
        }
        return { x: ix, y: iy };
      }

      function updatePlayer(dt) {
        const p = state.player;
        const maxCharges = getMaxDashCharges();

        if (p.dashTimer > 0) p.dashTimer = Math.max(0, p.dashTimer - dt);
        if (p.dashInvulnTimer > 0) p.dashInvulnTimer = Math.max(0, p.dashInvulnTimer - dt);
        if (p.hurtInvulnTimer > 0) p.hurtInvulnTimer = Math.max(0, p.hurtInvulnTimer - dt);
        if (p.dashChainLock > 0) p.dashChainLock = Math.max(0, p.dashChainLock - dt);

        // Atılma dolumu (tüm yükler dolum bitince yenilenir)
        if (p.dashCharges < maxCharges) {
          p.dashCooldownTimer -= dt;
          if (p.dashCooldownTimer <= 0) {
            p.dashCharges = maxCharges;
            p.dashCooldownTimer = 0;
          }
        }

        const input = getMovementInput();
        if (Math.hypot(input.x, input.y) > 0.1) {
          const len = Math.hypot(input.x, input.y);
          p.facingX = input.x / len;
          p.facingY = input.y / len;
        }

        if (p.dashTimer <= 0) {
          const accel = getPlayerAccel();
          const maxSpd = getPlayerMaxSpeed();
          p.vx += input.x * accel * dt;
          p.vy += input.y * accel * dt;

          const damp = Math.exp(-CONFIG.playerFriction * dt);
          p.vx *= damp;
          p.vy *= damp;

          // Girdap çekimi (oyuncuyu belirgin şekilde çeker)
          for (let i = 0; i < state.vortices.length; i++) {
            const v = state.vortices[i];
            const dx = v.x - p.x;
            const dy = v.y - p.y;
            const d = Math.hypot(dx, dy);
            if (d > 10 && d < v.radius) {
              const strength = 0.45 + 0.85 * (1 - d / v.radius);
              p.vx += (dx / d) * CONFIG.vortexPlayerPull * strength * dt;
              p.vy += (dy / d) * CONFIG.vortexPlayerPull * strength * dt;
            }
          }

          const spd = Math.hypot(p.vx, p.vy);
          if (spd > maxSpd) {
            p.vx = (p.vx / spd) * maxSpd;
            p.vy = (p.vy / spd) * maxSpd;
          }
        }

        p.x += p.vx * dt;
        p.y += p.vy * dt;

        // Arena duvar çarpışması
        const minX = CONFIG.arenaMargin + p.radius;
        const maxX = viewWidth - CONFIG.arenaMargin - p.radius;
        const minY = CONFIG.arenaMargin + p.radius;
        const maxY = viewHeight - CONFIG.arenaMargin - p.radius;

        if (p.x < minX) { p.x = minX; p.vx = Math.max(0, p.vx); }
        if (p.x > maxX) { p.x = maxX; p.vx = Math.min(0, p.vx); }
        if (p.y < minY) { p.y = minY; p.vy = Math.max(0, p.vy); }
        if (p.y > maxY) { p.y = maxY; p.vy = Math.min(0, p.vy); }

        // Hareket izi
        p.trail.push({ x: p.x, y: p.y, dash: p.dashTimer > 0 });
        if (p.trail.length > 16) p.trail.shift();
      }

      function updateCollectibles(dt) {
        const p = state.player;
        const magRadius = getMagnetRadius();
        const hasMagnetBoost = UpgradeSystem.computedStats.magnetRadiusMult > 1;
        const magSpeed = hasMagnetBoost ? 280 + magRadius * 0.85 : 170;

        // Altın Küreler
        for (let i = state.shards.length - 1; i >= 0; i--) {
          const s = state.shards[i];
          s.pulse += dt * 5;
          s.life -= dt;
          if (s.life <= 0) {
            state.shards.splice(i, 1);
            continue;
          }

          const d = dist(p.x, p.y, s.x, s.y);
          if (d < magRadius && d > 1) {
            const pull = magSpeed * (1.2 - d / magRadius);
            s.x += ((p.x - s.x) / d) * pull * dt;
            s.y += ((p.y - s.y) / d) * pull * dt;
          }

          if (d <= p.radius + s.radius + 4) {
            state.shards.splice(i, 1);

            if (state.comboTimer > 0) {
              state.combo = Math.min(CONFIG.maxCombo, state.combo + 1);
            } else {
              state.combo = 1;
            }
            state.comboTimer = CONFIG.comboDuration;
            const gained = 10 * state.combo;
            addScore(gained);
            spawnParticles(s.x, s.y, COLORS.gold, 10, 50, 170, 2, 4);
            addFloatingText(s.x, s.y - 10, `+${gained}`, COLORS.gold, 13);
            Sound.pickup(state.combo);

            // Altın Sayacı & Kademeli Altın Kalp (15 / 20 / 25)
            state.totalGoldCollected += 1;
            if (canSpawnMoreGoldenHearts()) {
              const goldReq = getCurrentGoldHeartThreshold();
              state.goldCounter = Math.min(goldReq, state.goldCounter + 1);
              trySpawnGoldenHeartIfReady();
            }

            UpgradeSystem.emit('onGoldCollect', s);
          }
        }

        // Şok Küreleri
        for (let i = state.shockOrbs.length - 1; i >= 0; i--) {
          const o = state.shockOrbs[i];
          o.pulse += dt * 4.5;
          o.life -= dt;
          if (o.life <= 0) {
            state.shockOrbs.splice(i, 1);
            continue;
          }

          const d = dist(p.x, p.y, o.x, o.y);
          if (hasMagnetBoost && d < magRadius && d > 1) {
            o.x += ((p.x - o.x) / d) * magSpeed * 0.75 * dt;
            o.y += ((p.y - o.y) / d) * magSpeed * 0.75 * dt;
          }

          if (d <= p.radius + o.radius + 5) {
            state.shockOrbs.splice(i, 1);
            triggerShockwave(o.x, o.y, 240, COLORS.cyan, false, false, 'shock_orb');
          }
        }

        // Altın Kalp Toplamaları
        for (let i = state.goldenHeartPickups.length - 1; i >= 0; i--) {
          const h = state.goldenHeartPickups[i];
          h.pulse += dt * 4.2;
          const d = dist(p.x, p.y, h.x, h.y);
          if (hasMagnetBoost && d < magRadius && d > 1) {
            h.x += ((p.x - h.x) / d) * magSpeed * 0.8 * dt;
            h.y += ((p.y - h.y) / d) * magSpeed * 0.8 * dt;
          }

          if (d <= p.radius + h.radius + 6) {
            state.goldenHeartPickups.splice(i, 1);
            if (state.goldenHearts < CONFIG.maxGoldenHearts) {
              const idx = state.goldenHearts;
              state.goldenHearts++;
              updateHeartsHUD(idx);
              addFloatingText(h.x, h.y - 16, '♥ +1 ALTIN KALP!', COLORS.goldBright, 16);
            } else {
              addScore(150);
              addFloatingText(h.x, h.y - 16, '♥ MAKS CAN +150', COLORS.goldBright, 15);
            }
            spawnParticles(h.x, h.y, COLORS.gold, 24, 70, 230, 2.5, 5);
            Sound.goldenHeartPickup();
            updateHUDMeters();
          }
        }
      }

      function updateEnemies(dt) {
        const p = state.player;
        const grazeMargin = getGrazeMargin();
        const pad = CONFIG.arenaMargin;

        for (let i = state.enemies.length - 1; i >= 0; i--) {
          const e = state.enemies[i];
          if (e.grazeCooldown > 0) e.grazeCooldown = Math.max(0, e.grazeCooldown - dt);
          if (e.slowTimer > 0) {
            e.slowTimer = Math.max(0, e.slowTimer - dt);
            if (e.slowTimer === 0) e.slowFactor = 1;
          }

          const effDt = dt * (e.slowTimer > 0 ? e.slowFactor : 1);

          if (e.type === 'chaser') {
            const angle = Math.atan2(p.y - e.y, p.x - e.x);
            const targetVx = Math.cos(angle) * e.speed;
            const targetVy = Math.sin(angle) * e.speed;
            e.vx += (targetVx - e.vx) * Math.min(1, effDt * 4.5);
            e.vy += (targetVy - e.vy) * Math.min(1, effDt * 4.5);
            e.spin += effDt * 3.2;
          } else if (e.type === 'lancer') {
            e.timer -= effDt;
            if (e.state === 'aiming') {
              const targetAngle = Math.atan2(p.y - e.y, p.x - e.x);
              let diff = targetAngle - e.angle;
              while (diff > Math.PI) diff -= Math.PI * 2;
              while (diff < -Math.PI) diff += Math.PI * 2;
              e.angle += diff * Math.min(1, effDt * 6.5);
              e.vx *= 0.88;
              e.vy *= 0.88;
              if (e.timer <= 0) {
                e.state = 'dashing';
                e.timer = 0.85;
                e.vx = Math.cos(e.angle) * e.dashSpeed;
                e.vy = Math.sin(e.angle) * e.dashSpeed;
                e.hitElites.clear();
                Sound.playTone(340, 0.1, 'sawtooth', 0.045, 580);
              }
            } else if (e.state === 'dashing') {
              if (e.timer <= 0) {
                e.state = 'recover';
                e.timer = 0.7;
              }
            } else {
              e.vx *= Math.exp(-5 * effDt);
              e.vy *= Math.exp(-5 * effDt);
              if (e.timer <= 0) {
                e.state = 'aiming';
                e.timer = 1.05;
              }
            }
          } else if (e.type === 'bouncer') {
            e.spin += effDt * 4.5;
          }

          // Çekim Girdapları düşmanları güçlü çeker
          for (let vIdx = 0; vIdx < state.vortices.length; vIdx++) {
            const v = state.vortices[vIdx];
            const dx = v.x - e.x;
            const dy = v.y - e.y;
            const d = Math.hypot(dx, dy);
            if (d > 8 && d < v.radius) {
              const pull = CONFIG.vortexEnemyPull * (0.45 + 0.85 * (1 - d / v.radius));
              e.vx += (dx / d) * pull * effDt;
              e.vy += (dy / d) * pull * effDt;
            }
          }

          e.x += e.vx * effDt;
          e.y += e.vy * effDt;

          // Duvar sınırları
          if (e.type === 'bouncer') {
            if (e.x < pad + e.radius) { e.x = pad + e.radius; e.vx = Math.abs(e.vx); }
            if (e.x > viewWidth - pad - e.radius) { e.x = viewWidth - pad - e.radius; e.vx = -Math.abs(e.vx); }
            if (e.y < pad + e.radius) { e.y = pad + e.radius; e.vy = Math.abs(e.vy); }
            if (e.y > viewHeight - pad - e.radius) { e.y = viewHeight - pad - e.radius; e.vy = -Math.abs(e.vy); }
          } else if (e.type === 'lancer' && e.state === 'dashing') {
            if (
              e.x < pad + e.radius || e.x > viewWidth - pad - e.radius ||
              e.y < pad + e.radius || e.y > viewHeight - pad - e.radius
            ) {
              e.x = clamp(e.x, pad + e.radius, viewWidth - pad - e.radius);
              e.y = clamp(e.y, pad + e.radius, viewHeight - pad - e.radius);
              e.state = 'recover';
              e.timer = 0.65;
              e.vx *= -0.25;
              e.vy *= -0.25;
              spawnParticles(e.x, e.y, COLORS.orange, 8, 50, 150, 2, 3.5);
            }
          } else {
            e.x = clamp(e.x, pad + e.radius, viewWidth - pad - e.radius);
            e.y = clamp(e.y, pad + e.radius, viewHeight - pad - e.radius);
          }
        }

        // YEMLEME MEKANİĞİ: Fırlayan Mızrak -> Takipçi / Seken imhası & Elit Çekirdek hasarı
        for (let i = state.enemies.length - 1; i >= 0; i--) {
          const lancer = state.enemies[i];
          if (!lancer || lancer.type !== 'lancer' || lancer.state !== 'dashing') continue;

          for (let j = state.enemies.length - 1; j >= 0; j--) {
            if (i === j) continue;
            const victim = state.enemies[j];
            if (!victim || victim.type === 'lancer') continue;
            if (dist(lancer.x, lancer.y, victim.x, victim.y) <= lancer.radius + victim.radius + 3) {
              const pts = CONFIG.baitPoints * state.combo;
              state.baitKills++;
              addScore(pts);
              spawnParticles(victim.x, victim.y, COLORS.orange, 16, 80, 260, 2.2, 5);
              addFloatingText(victim.x, victim.y - 12, `YEMLEME! +${pts}`, COLORS.orange, 15);
              Sound.baitKill();
              addScreenShake(4.5, 0.14);
              state.enemies.splice(j, 1);
              if (j < i) i--;
            }
          }

          for (let k = state.eliteCores.length - 1; k >= 0; k--) {
            const core = state.eliteCores[k];
            if (!lancer.hitElites.has(core.id) && dist(lancer.x, lancer.y, core.x, core.y) <= lancer.radius + core.radius) {
              lancer.hitElites.add(core.id);
              state.baitKills++;
              const pts = 80 * state.combo;
              addScore(pts);
              const dead = damageEliteCore(core, 1, lancer.x, lancer.y, 'YEMLEME!');
              if (dead) state.eliteCores.splice(k, 1);
            }
          }
        }

        // Oyuncu çarpışma & Kıl Payı kontrolü
        for (let i = 0; i < state.enemies.length; i++) {
          const e = state.enemies[i];
          const d = dist(p.x, p.y, e.x, e.y);
          const hitDist = p.radius + e.radius - 2;
          if (d <= hitDist) {
            if (p.dashInvulnTimer > 0) {
              if (e.grazeCooldown <= 0) {
                e.grazeCooldown = 0.75;
                awardNearMiss(e.x, e.y, e);
              }
            } else {
              handlePlayerHit();
              return;
            }
          } else if (d <= hitDist + grazeMargin && e.grazeCooldown <= 0) {
            e.grazeCooldown = 0.85;
            awardNearMiss((p.x + e.x) / 2, (p.y + e.y) / 2, e);
          }
        }
      }

      function updateEliteCores(dt) {
        const p = state.player;
        const grazeMargin = getGrazeMargin();
        const pad = CONFIG.arenaMargin + 40;

        for (let i = 0; i < state.eliteCores.length; i++) {
          const c = state.eliteCores[i];
          if (c.flashTimer > 0) c.flashTimer = Math.max(0, c.flashTimer - dt);
          if (c.grazeCooldown > 0) c.grazeCooldown = Math.max(0, c.grazeCooldown - dt);
          if (c.slowTimer > 0) {
            c.slowTimer = Math.max(0, c.slowTimer - dt);
            if (c.slowTimer === 0) c.slowFactor = 1;
          }

          const effDt = dt * (c.slowTimer > 0 ? c.slowFactor : 1);
          c.spin += effDt * 1.9;

          const angToP = Math.atan2(p.y - c.y, p.x - c.x);
          c.vx += Math.cos(angToP) * 42 * effDt;
          c.vy += Math.sin(angToP) * 42 * effDt;
          const spd = Math.hypot(c.vx, c.vy);
          if (spd > 78) {
            c.vx = (c.vx / spd) * 78;
            c.vy = (c.vy / spd) * 78;
          }

          c.x = clamp(c.x + c.vx * effDt, pad, viewWidth - pad);
          c.y = clamp(c.y + c.vy * effDt, pad + 35, viewHeight - pad);

          c.fireTimer -= effDt;
          if (c.fireTimer <= 0) {
            c.fireTimer = Math.max(1.35, 2.25 - state.wave * 0.08);
            const count = c.patternToggle % 2 === 0 ? 8 : 6;
            const baseAngle = c.patternToggle % 2 === 0 ? c.spin : angToP;
            const projSpeed = 230 + Math.min(90, state.wave * 12);
            c.patternToggle++;

            for (let k = 0; k < count; k++) {
              const a = baseAngle + (Math.PI * 2 * k) / count;
              state.eliteProjectiles.push({
                x: c.x + Math.cos(a) * (c.radius + 4),
                y: c.y + Math.sin(a) * (c.radius + 4),
                vx: Math.cos(a) * projSpeed,
                vy: Math.sin(a) * projSpeed,
                radius: 6,
                life: 5.5,
                grazed: false
              });
            }
            Sound.playTone(260, 0.12, 'triangle', 0.06, 140);
          }

          const d = dist(p.x, p.y, c.x, c.y);
          const hitDist = p.radius + c.radius - 3;
          if (d <= hitDist) {
            if (p.dashInvulnTimer > 0) {
              if (c.grazeCooldown <= 0) {
                c.grazeCooldown = 0.85;
                awardNearMiss(c.x, c.y, c);
              }
            } else {
              handlePlayerHit();
              return;
            }
          } else if (d <= hitDist + grazeMargin && c.grazeCooldown <= 0) {
            c.grazeCooldown = 0.9;
            awardNearMiss((p.x + c.x) / 2, (p.y + c.y) / 2, c);
          }
        }

        // Elit Mermileri
        for (let i = state.eliteProjectiles.length - 1; i >= 0; i--) {
          const pr = state.eliteProjectiles[i];
          pr.x += pr.vx * dt;
          pr.y += pr.vy * dt;
          pr.life -= dt;
          if (
            pr.life <= 0 ||
            pr.x < -20 || pr.x > viewWidth + 20 ||
            pr.y < -20 || pr.y > viewHeight + 20
          ) {
            state.eliteProjectiles.splice(i, 1);
            continue;
          }

          const d = dist(p.x, p.y, pr.x, pr.y);
          const hitDist = p.radius + pr.radius - 1;
          if (d <= hitDist) {
            if (p.dashInvulnTimer > 0) {
              if (!pr.grazed) {
                pr.grazed = true;
                awardNearMiss(pr.x, pr.y);
              }
            } else {
              state.eliteProjectiles.splice(i, 1);
              handlePlayerHit();
              return;
            }
          } else if (!pr.grazed && d <= hitDist + grazeMargin * 0.78) {
            pr.grazed = true;
            awardNearMiss(pr.x, pr.y);
          }
        }
      }

      function updateArenaEvents(dt) {
        const p = state.player;
        const grazeMargin = getGrazeMargin();

        for (let i = state.vortices.length - 1; i >= 0; i--) {
          const v = state.vortices[i];
          v.timer -= dt;
          v.angle += dt * 3.4;
          if (v.timer <= 0) {
            state.vortices.splice(i, 1);
          }
        }

        for (let i = state.lasers.length - 1; i >= 0; i--) {
          const l = state.lasers[i];
          l.timer -= dt;
          if (l.grazeCooldown > 0) l.grazeCooldown = Math.max(0, l.grazeCooldown - dt);

          if (l.phase === 'warning' && l.timer <= 0) {
            l.phase = 'active';
            l.timer = CONFIG.laserActiveTime;
            Sound.laserFire();
            addScreenShake(4, 0.14);
          } else if (l.phase === 'active') {
            const d = pointToSegmentDistance(p.x, p.y, l.x1, l.y1, l.x2, l.y2);
            const beamHalf = 9;
            if (d <= p.radius + beamHalf - 2) {
              if (p.dashInvulnTimer > 0) {
                if (l.grazeCooldown <= 0) {
                  l.grazeCooldown = 0.85;
                  awardNearMiss(p.x, p.y);
                }
              } else {
                handlePlayerHit();
                return;
              }
            } else if (d <= p.radius + beamHalf + grazeMargin * 0.8 && l.grazeCooldown <= 0) {
              l.grazeCooldown = 0.9;
              awardNearMiss(p.x, p.y);
            }

            if (l.timer <= 0) {
              state.lasers.splice(i, 1);
            }
          }
        }
      }

      function updatePoison(dt) {
        if (!state.poisonActive) return;

        state.poisonTimer -= dt;
        if (state.poisonTimer <= 0) {
          const p = state.player;
          if (p.hurtInvulnTimer > 0) {
            state.poisonTimer = 0.05;
            return;
          }
          const nextInterval = getPoisonInterval();
          state.poisonMaxTimer = nextInterval;
          state.poisonTimer = nextInterval;
          state.poisonFlash = 1;
          spawnParticles(p.x, p.y, COLORS.poison, 24, 70, 240, 2.5, 5.2);
          spawnParticles(p.x, p.y, COLORS.poisonBright, 12, 40, 150, 2, 4);
          addFloatingText(p.x, p.y - 36, '☠️ ZEHİR HASARI!', COLORS.poisonBright, 16);
          Sound.poisonTick();
          handlePlayerHit(true);
        }
      }

      function updateVisualEffects(dt) {
        for (let i = state.shockwaves.length - 1; i >= 0; i--) {
          const sw = state.shockwaves[i];
          sw.radius += (sw.maxRadius - sw.radius) * Math.min(1, dt * 11) + 260 * dt;
          sw.alpha = clamp(1 - sw.radius / sw.maxRadius, 0, 1);
          if (sw.radius >= sw.maxRadius) state.shockwaves.splice(i, 1);
        }

        for (let i = state.particles.length - 1; i >= 0; i--) {
          const pt = state.particles[i];
          pt.x += pt.vx * dt;
          pt.y += pt.vy * dt;
          pt.vx *= Math.exp(-3.5 * dt);
          pt.vy *= Math.exp(-3.5 * dt);
          pt.life -= dt;
          if (pt.life <= 0) state.particles.splice(i, 1);
        }

        for (let i = state.floatingTexts.length - 1; i >= 0; i--) {
          const ft = state.floatingTexts[i];
          ft.y += ft.vy * dt;
          ft.life -= dt;
          if (ft.life <= 0) state.floatingTexts.splice(i, 1);
        }

        if (state.shakeTime > 0) {
          state.shakeTime = Math.max(0, state.shakeTime - dt);
          if (state.shakeTime === 0) state.shakePower = 0;
        }

        if (state.bannerTimer > 0) {
          state.bannerTimer -= dt;
          if (state.bannerTimer <= 0) {
            eventBanner.classList.remove('visible');
          }
        }

        if (state.poisonFlash > 0) {
          state.poisonFlash = Math.max(0, state.poisonFlash - dt * 1.9);
        }
      }

      function updateSpawners(dt) {
        state.shardSpawnTimer -= dt;
        const maxShards = 6 + Math.min(4, state.wave);
        if (state.shardSpawnTimer <= 0 && state.shards.length < maxShards) {
          spawnShard();
          state.shardSpawnTimer = rand(1.1, 1.85);
        }

        state.shockOrbSpawnTimer -= dt;
        if (state.shockOrbSpawnTimer <= 0 && state.shockOrbs.length < 2) {
          spawnShockOrb();
          state.shockOrbSpawnTimer = rand(9.5, 13.5);
        }

        state.enemySpawnTimer -= dt;
        const maxEnemies = 9 + state.wave * 3;
        if (state.enemySpawnTimer <= 0 && state.enemies.length < maxEnemies) {
          spawnEnemy();
          const baseInterval = Math.max(0.68, 1.85 - (state.wave - 1) * 0.16 - Math.min(0.45, state.time / 240));
          state.enemySpawnTimer = baseInterval * rand(0.85, 1.15);
        }

        state.eventSpawnTimer -= dt;
        if (state.eventSpawnTimer <= 0) {
          if (Math.random() < 0.5 && state.vortices.length < 2) {
            spawnVortex();
          } else {
            spawnLaserBarrier();
          }
          state.eventSpawnTimer = Math.max(7.0, 12.5 - state.wave * 0.6) * rand(0.85, 1.15);
        }

        if (state.wave >= 2) {
          state.eliteSpawnTimer -= dt;
          if (state.eliteSpawnTimer <= 0 && state.eliteCores.length < Math.min(2, Math.floor(state.wave / 2))) {
            spawnEliteCore();
            state.eliteSpawnTimer = Math.max(18, 28 - state.wave * 1.5);
          }
        }
      }

      function updateGame(dt) {
        Sound.updateRhythm(dt, state.combo, state.mode === 'playing');

        if (state.mode !== 'playing') {
          updateVisualEffects(dt);
          return;
        }

        if (state.hitstopTimer > 0) {
          state.hitstopTimer = Math.max(0, state.hitstopTimer - dt);
          updateVisualEffects(dt * 0.35);
          return;
        }

        state.time += dt;

        if (state.comboTimer > 0) {
          state.comboTimer -= dt;
          if (state.comboTimer <= 0) {
            state.comboTimer = 0;
            state.combo = 1;
          }
        }

        state.waveTimer -= dt;
        if (state.waveTimer <= 0) {
          state.waveTimer = 0;
          updateHUDMeters();
          openUpgradeSelection();
          return;
        }

        updatePlayer(dt);
        updateCollectibles(dt);
        UpgradeSystem.emit('onUpdate', dt);
        updateArenaEvents(dt);
        if (state.mode !== 'playing') return;
        updatePoison(dt);
        if (state.mode !== 'playing') return;
        updateEnemies(dt);
        if (state.mode !== 'playing') return;
        updateEliteCores(dt);
        if (state.mode !== 'playing') return;
        updateSpawners(dt);
        updateVisualEffects(dt);
        updateHUDMeters();
      }

      /* -----------------------------------------------------------------------
         12. ÇİZİM (CANVAS RENDERING)
         ----------------------------------------------------------------------- */
      function drawBackground() {
        ctx.fillStyle = COLORS.bg;
        ctx.fillRect(0, 0, viewWidth, viewHeight);

        const gridSize = 48;
        ctx.strokeStyle = COLORS.grid;
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let x = CONFIG.arenaMargin; x < viewWidth; x += gridSize) {
          ctx.moveTo(x, CONFIG.arenaMargin);
          ctx.lineTo(x, viewHeight - CONFIG.arenaMargin);
        }
        for (let y = CONFIG.arenaMargin; y < viewHeight; y += gridSize) {
          ctx.moveTo(CONFIG.arenaMargin, y);
          ctx.lineTo(viewWidth - CONFIG.arenaMargin, y);
        }
        ctx.stroke();

        if (state.mode === 'playing' && (state.combo >= 2 || Sound.beatPulse > 0.05)) {
          const glowAlpha = clamp((state.combo - 1) * 0.045 + Sound.beatPulse * 0.08, 0, 0.24);
          const grad = ctx.createRadialGradient(
            viewWidth / 2,
            viewHeight / 2,
            Math.min(viewWidth, viewHeight) * 0.34,
            viewWidth / 2,
            viewHeight / 2,
            Math.max(viewWidth, viewHeight) * 0.72
          );
          const edgeColor = state.combo >= 4 ? `rgba(255, 209, 102, ${glowAlpha})` : `rgba(0, 245, 255, ${glowAlpha})`;
          grad.addColorStop(0, 'rgba(0, 0, 0, 0)');
          grad.addColorStop(1, edgeColor);
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, viewWidth, viewHeight);
        }

        const m = CONFIG.arenaMargin;
        if (state.poisonActive) {
          const urgent = state.poisonTimer <= 5;
          const borderPulse = 0.65 + 0.35 * Math.sin(state.time * (urgent ? 10 : 3.2));
          ctx.save();
          ctx.shadowColor = COLORS.poison;
          ctx.shadowBlur = urgent ? 24 : 14;
          ctx.strokeStyle = `rgba(74, 222, 128, ${0.55 + 0.38 * borderPulse})`;
          ctx.lineWidth = urgent ? 2.6 : 2;
          ctx.strokeRect(m, m, viewWidth - m * 2, viewHeight - m * 2);
          ctx.restore();
        } else {
          ctx.strokeStyle = COLORS.borderNeon;
          ctx.lineWidth = 1.5;
          ctx.strokeRect(m, m, viewWidth - m * 2, viewHeight - m * 2);
        }
      }

      function drawVortices() {
        const p = state.player;
        const tNow = state.time;

        for (let i = 0; i < state.vortices.length; i++) {
          const v = state.vortices[i];
          const fade = Math.min(1, v.timer / 1.2, (v.maxLife - v.timer) / 0.6 + 0.15);

          ctx.save();
          ctx.globalAlpha = fade;

          // Girdap alanı parlaması
          const grad = ctx.createRadialGradient(v.x, v.y, 4, v.x, v.y, v.radius);
          grad.addColorStop(0, 'rgba(181, 92, 255, 0.48)');
          grad.addColorStop(0.45, 'rgba(181, 92, 255, 0.15)');
          grad.addColorStop(1, 'rgba(181, 92, 255, 0)');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(v.x, v.y, v.radius, 0, Math.PI * 2);
          ctx.fill();

          // Merkeze doğru daralan çekim halkaları
          for (let rIdx = 0; rIdx < 3; rIdx++) {
            const rPhase = (tNow * 0.55 + rIdx / 3) % 1;
            const ringR = 16 + (1 - Math.pow(rPhase, 1.35)) * (v.radius - 22);
            const ringAlpha = Math.sin(rPhase * Math.PI) * 0.24;
            ctx.strokeStyle = `rgba(216, 180, 254, ${ringAlpha})`;
            ctx.lineWidth = 1.4;
            ctx.beginPath();
            ctx.arc(v.x, v.y, ringR, 0, Math.PI * 2);
            ctx.stroke();
          }

          // Merkeze doğru spiral çizerek emilen mor ışık/toz zerrecikleri
          for (let m = 0; m < 16; m++) {
            const phase = (tNow * 0.62 + m / 16) % 1;
            const accel = Math.pow(phase, 1.45);
            const r = 15 + (1 - accel) * (v.radius - 18);
            const theta = v.angle * 1.1 + m * 2.39996 + accel * 4.4;
            const mx = v.x + Math.cos(theta) * r;
            const my = v.y + Math.sin(theta) * r;
            const tailTheta = theta - 0.16;
            const tailR = r + 7 * (1 - accel * 0.5);
            const tx = v.x + Math.cos(tailTheta) * tailR;
            const ty = v.y + Math.sin(tailTheta) * tailR;
            const moteAlpha = Math.sin(phase * Math.PI) * 0.85;

            ctx.strokeStyle = `rgba(192, 132, 252, ${moteAlpha * 0.65})`;
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(tx, ty);
            ctx.lineTo(mx, my);
            ctx.stroke();

            ctx.fillStyle = `rgba(243, 232, 255, ${moteAlpha})`;
            ctx.beginPath();
            ctx.arc(mx, my, 1.4 + (1 - accel) * 1.4, 0, Math.PI * 2);
            ctx.fill();
          }

          // Dönen spiral kollar ve siyah çekirdek
          ctx.save();
          ctx.translate(v.x, v.y);
          ctx.rotate(v.angle);
          ctx.strokeStyle = 'rgba(216, 180, 254, 0.58)';
          ctx.lineWidth = 2;
          for (let arm = 0; arm < 3; arm++) {
            const base = (Math.PI * 2 * arm) / 3;
            ctx.beginPath();
            ctx.arc(0, 0, 32 + arm * 18, base, base + Math.PI * 0.9);
            ctx.stroke();
          }

          ctx.fillStyle = '#0c0618';
          ctx.beginPath();
          ctx.arc(0, 0, 14, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = COLORS.violet;
          ctx.lineWidth = 2.5;
          ctx.stroke();
          ctx.restore();

          // Oyuncu girdabın çekim alanındayken çok katmanlı hareketli çekim animasyonu
          const d = dist(p.x, p.y, v.x, v.y);
          if (state.mode === 'playing' && d > 16 && d < v.radius && p.dashTimer <= 0) {
            const pullStrength = clamp(1 - d / v.radius, 0.12, 1);
            const ux = (v.x - p.x) / d;
            const uy = (v.y - p.y) / d;
            const nx = -uy;
            const ny = ux;
            const pullAngle = Math.atan2(uy, ux);

            ctx.save();

            // 1) Oyuncunun girdaba bakan tarafında mor çekim gerilimi yayı (tidal arc)
            const arcPulse = 0.65 + 0.35 * Math.sin(tNow * 11);
            ctx.shadowColor = COLORS.violet;
            ctx.shadowBlur = 14;
            ctx.strokeStyle = `rgba(216, 180, 254, ${(0.45 + 0.45 * pullStrength) * arcPulse})`;
            ctx.lineWidth = 2.6;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius + 6, pullAngle - 0.85, pullAngle + 0.85);
            ctx.stroke();

            ctx.strokeStyle = `rgba(181, 92, 255, ${0.3 + 0.35 * pullStrength})`;
            ctx.lineWidth = 1.6;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius + 10, pullAngle - 0.62, pullAngle + 0.62);
            ctx.stroke();

            // 2) Merkeze doğru daralarak akan enerji halkaları
            for (let ring = 0; ring < 3; ring++) {
              const rawR = (tNow * (1.25 + pullStrength * 0.55) + ring / 3) % 1;
              const tr = Math.pow(rawR, 1.45);
              const rx = p.x + ux * (p.radius + 4 + tr * Math.max(8, d - p.radius - 18));
              const ry = p.y + uy * (p.radius + 4 + tr * Math.max(8, d - p.radius - 18));
              const majorR = Math.max(4, (p.radius + 6) * (1 - tr * 0.68));
              const minorR = majorR * 0.42;
              const rAlpha = Math.sin(rawR * Math.PI) * (0.35 + 0.45 * pullStrength);

              ctx.save();
              ctx.translate(rx, ry);
              ctx.rotate(pullAngle + Math.PI * 0.5);
              ctx.strokeStyle = `rgba(192, 132, 252, ${rAlpha})`;
              ctx.lineWidth = 1.6;
              ctx.beginPath();
              ctx.ellipse(0, 0, majorR, minorR, 0, 0, Math.PI * 2);
              ctx.stroke();
              ctx.restore();
            }

            // 3) Oyuncudan merkeze kıvrılan 3 parlayan kavisli enerji akışı + hızlanan parçacıklar
            for (let s = 0; s < 3; s++) {
              const side = s - 1; // -1, 0, +1
              const startAng = pullAngle + side * 0.55;
              const sx = p.x + Math.cos(startAng) * (p.radius + 3);
              const sy = p.y + Math.sin(startAng) * (p.radius + 3);
              const ex = v.x - ux * 13 + nx * side * 3;
              const ey = v.y - uy * 13 + ny * side * 3;

              const wave = Math.sin(tNow * 7.2 + s * 2.15) * (9 + 11 * pullStrength);
              const arch = side * Math.min(34, d * 0.24) + wave;
              const cx = (sx + ex) * 0.5 + nx * arch;
              const cy = (sy + ey) * 0.5 + ny * arch;

              ctx.strokeStyle = side === 0
                ? `rgba(216, 180, 254, ${0.32 + 0.44 * pullStrength})`
                : `rgba(181, 92, 255, ${0.22 + 0.36 * pullStrength})`;
              ctx.lineWidth = side === 0 ? 2.2 : 1.5;
              ctx.beginPath();
              ctx.moveTo(sx, sy);
              ctx.quadraticCurveTo(cx, cy, ex, ey);
              ctx.stroke();

              // Akış boyunca hızlanarak (Math.pow(t, 1.55)) emilen parlak enerji parçacıkları
              for (let k = 0; k < 4; k++) {
                const rawP = (tNow * (1.2 + pullStrength * 0.75) + k * 0.25 + s * 0.17) % 1;
                const tp = Math.pow(rawP, 1.55);
                const mt = 1 - tp;
                const px = mt * mt * sx + 2 * mt * tp * cx + tp * tp * ex;
                const py = mt * mt * sy + 2 * mt * tp * cy + tp * tp * ey;
                const pAlpha = Math.sin(rawP * Math.PI) * (0.55 + 0.45 * pullStrength);
                const pSize = (1.8 + 1.7 * pullStrength) * (1 - tp * 0.32);

                ctx.fillStyle = `rgba(243, 232, 255, ${pAlpha})`;
                ctx.beginPath();
                ctx.arc(px, py, pSize, 0, Math.PI * 2);
                ctx.fill();
              }
            }

            // 4) Merkeze bakan hareketli akış okları (chevron'lar)
            ctx.lineWidth = 2;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            for (let cIdx = 0; cIdx < 3; cIdx++) {
              const rawC = (tNow * (1.35 + pullStrength * 0.7) + cIdx / 3) % 1;
              const tc = Math.pow(rawC, 1.55);
              const distAlong = p.radius + 10 + tc * Math.max(10, d - p.radius - 26);
              const ax = p.x + ux * distAlong;
              const ay = p.y + uy * distAlong;
              const chevSize = (5.5 + 3 * pullStrength) * (1 - tc * 0.25);
              const cAlpha = Math.sin(rawC * Math.PI) * (0.5 + 0.45 * pullStrength);

              ctx.strokeStyle = `rgba(233, 213, 255, ${cAlpha})`;
              ctx.beginPath();
              ctx.moveTo(ax - ux * chevSize + nx * chevSize * 0.85, ay - uy * chevSize + ny * chevSize * 0.85);
              ctx.lineTo(ax + ux * chevSize * 0.35, ay + uy * chevSize * 0.35);
              ctx.lineTo(ax - ux * chevSize - nx * chevSize * 0.85, ay - uy * chevSize - ny * chevSize * 0.85);
              ctx.stroke();
            }

            ctx.restore();
          }

          ctx.restore();
        }
      }

      function drawPoisonAtmosphere() {
        if (!state.poisonActive && state.poisonFlash <= 0) return;

        ctx.save();
        const tNow = state.time;

        if (state.poisonActive) {
          const urgent = state.poisonTimer <= 5;
          const pulseSpeed = urgent ? 9.5 : 2.8;
          const pulse = 0.5 + 0.5 * Math.sin(tNow * pulseSpeed);
          const edgeAlpha = (urgent ? 0.22 + 0.16 * pulse : 0.11 + 0.06 * pulse) + state.poisonFlash * 0.22;

          // Ekran kenarlarında nabız atan yeşil zehir vinyeti
          const innerR = Math.min(viewWidth, viewHeight) * (urgent ? 0.28 : 0.36);
          const outerR = Math.max(viewWidth, viewHeight) * 0.74;
          const grad = ctx.createRadialGradient(
            viewWidth * 0.5,
            viewHeight * 0.5,
            innerR,
            viewWidth * 0.5,
            viewHeight * 0.5,
            outerR
          );
          grad.addColorStop(0, 'rgba(34, 197, 94, 0)');
          grad.addColorStop(0.7, `rgba(22, 163, 74, ${edgeAlpha * 0.38})`);
          grad.addColorStop(1, `rgba(34, 197, 94, ${clamp(edgeAlpha, 0, 0.55)})`);
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, viewWidth, viewHeight);

          // Kenarlardan ve arenadan süzülen hareketli yeşil zehir sporları / kabarcıkları
          const m = CONFIG.arenaMargin;
          for (let i = 0; i < 24; i++) {
            const seed = i * 1.6180339;
            const cycle = (tNow * (0.14 + (i % 4) * 0.04) + seed) % 1;
            const side = i % 4;
            const drift = Math.sin(tNow * 2.1 + seed * 5) * 18;
            let sx, sy;

            if (side === 0) {
              sx = m + ((seed * 193) % 1) * (viewWidth - m * 2) + drift;
              sy = viewHeight - m - cycle * 115;
            } else if (side === 1) {
              sx = m + ((seed * 271) % 1) * (viewWidth - m * 2) + drift;
              sy = m + cycle * 115;
            } else if (side === 2) {
              sx = m + cycle * 115;
              sy = m + ((seed * 317) % 1) * (viewHeight - m * 2) + drift;
            } else {
              sx = viewWidth - m - cycle * 115;
              sy = m + ((seed * 409) % 1) * (viewHeight - m * 2) + drift;
            }

            const sporeAlpha = Math.sin(cycle * Math.PI) * (urgent ? 0.65 : 0.42);
            const sporeR = 2.0 + (i % 3) * 1.3 + Math.sin(tNow * 4 + seed) * 0.5;
            ctx.fillStyle = i % 2 === 0
              ? `rgba(74, 222, 128, ${sporeAlpha})`
              : `rgba(34, 197, 94, ${sporeAlpha})`;
            ctx.beginPath();
            ctx.arc(sx, sy, Math.max(1, sporeR), 0, Math.PI * 2);
            ctx.fill();

            if (i % 3 === 0) {
              ctx.strokeStyle = `rgba(134, 239, 172, ${sporeAlpha * 0.7})`;
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.arc(sx, sy, sporeR + 2.2, 0, Math.PI * 2);
              ctx.stroke();
            }
          }
        }

        // Zehir hasarı anında kısa yeşil ekran parlaması
        if (state.poisonFlash > 0) {
          ctx.fillStyle = `rgba(34, 197, 94, ${state.poisonFlash * 0.16})`;
          ctx.fillRect(0, 0, viewWidth, viewHeight);
        }

        ctx.restore();
      }

      function drawLasers() {
        for (let i = 0; i < state.lasers.length; i++) {
          const l = state.lasers[i];
          ctx.save();
          if (l.phase === 'warning') {
            const blink = 0.35 + 0.5 * Math.abs(Math.sin(state.time * 16));
            ctx.strokeStyle = `rgba(255, 136, 17, ${blink})`;
            ctx.lineWidth = 2.5;
            ctx.setLineDash([12, 8]);
            ctx.beginPath();
            ctx.moveTo(l.x1, l.y1);
            ctx.lineTo(l.x2, l.y2);
            ctx.stroke();
          } else {
            ctx.shadowColor = COLORS.orange;
            ctx.shadowBlur = 22;
            ctx.strokeStyle = 'rgba(255, 85, 34, 0.85)';
            ctx.lineWidth = 18;
            ctx.beginPath();
            ctx.moveTo(l.x1, l.y1);
            ctx.lineTo(l.x2, l.y2);
            ctx.stroke();

            ctx.strokeStyle = '#fff7ed';
            ctx.lineWidth = 6;
            ctx.beginPath();
            ctx.moveTo(l.x1, l.y1);
            ctx.lineTo(l.x2, l.y2);
            ctx.stroke();
          }
          ctx.restore();
        }
      }

      function drawCollectibles() {
        for (let i = 0; i < state.shards.length; i++) {
          const s = state.shards[i];
          const r = s.radius + Math.sin(s.pulse) * 1.8;
          ctx.save();
          ctx.translate(s.x, s.y);
          ctx.rotate(s.pulse * 0.35);
          ctx.shadowColor = COLORS.gold;
          ctx.shadowBlur = 14;
          ctx.fillStyle = COLORS.gold;
          ctx.beginPath();
          ctx.moveTo(0, -r);
          ctx.lineTo(r * 0.85, 0);
          ctx.lineTo(0, r);
          ctx.lineTo(-r * 0.85, 0);
          ctx.closePath();
          ctx.fill();

          ctx.fillStyle = COLORS.goldBright;
          ctx.beginPath();
          ctx.arc(0, 0, r * 0.32, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }

        for (let i = 0; i < state.shockOrbs.length; i++) {
          const o = state.shockOrbs[i];
          const r = o.radius + Math.sin(o.pulse) * 2.2;
          ctx.save();
          ctx.translate(o.x, o.y);
          ctx.shadowColor = COLORS.cyan;
          ctx.shadowBlur = 18;
          ctx.strokeStyle = COLORS.cyan;
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.arc(0, 0, r, 0, Math.PI * 2);
          ctx.stroke();

          ctx.fillStyle = 'rgba(0, 245, 255, 0.25)';
          ctx.fill();

          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(0, 0, 4.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }

        for (let i = 0; i < state.goldenHeartPickups.length; i++) {
          const h = state.goldenHeartPickups[i];
          const scale = 1 + Math.sin(h.pulse) * 0.14;
          ctx.save();
          ctx.translate(h.x, h.y);
          ctx.scale(scale, scale);
          ctx.shadowColor = COLORS.gold;
          ctx.shadowBlur = 22;

          ctx.strokeStyle = 'rgba(255, 209, 102, 0.55)';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(0, 0, h.radius + 6, 0, Math.PI * 2);
          ctx.stroke();

          ctx.fillStyle = COLORS.gold;
          ctx.beginPath();
          ctx.moveTo(0, 8);
          ctx.bezierCurveTo(-14, -2, -13, -13, -5, -13);
          ctx.bezierCurveTo(-1, -13, 0, -9, 0, -7);
          ctx.bezierCurveTo(0, -9, 1, -13, 5, -13);
          ctx.bezierCurveTo(13, -13, 14, -2, 0, 8);
          ctx.closePath();
          ctx.fill();

          ctx.fillStyle = COLORS.goldBright;
          ctx.beginPath();
          ctx.arc(-4, -7, 2.3, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
      }

      function drawEnemies() {
        for (let i = 0; i < state.enemies.length; i++) {
          const e = state.enemies[i];
          ctx.save();
          if (e.type === 'chaser') {
            ctx.translate(e.x, e.y);
            ctx.rotate(e.spin);
            ctx.shadowColor = COLORS.crimson;
            ctx.shadowBlur = 14;
            ctx.fillStyle = COLORS.crimson;
            ctx.beginPath();
            for (let k = 0; k < 4; k++) {
              const a = (Math.PI / 2) * k;
              ctx.lineTo(Math.cos(a) * (e.radius + 2), Math.sin(a) * (e.radius + 2));
              ctx.lineTo(Math.cos(a + Math.PI / 4) * (e.radius * 0.55), Math.sin(a + Math.PI / 4) * (e.radius * 0.55));
            }
            ctx.closePath();
            ctx.fill();
          } else if (e.type === 'lancer') {
            if (e.state === 'aiming') {
              ctx.save();
              ctx.strokeStyle = 'rgba(255, 136, 17, 0.45)';
              ctx.lineWidth = 1.8;
              ctx.setLineDash([7, 7]);
              ctx.beginPath();
              ctx.moveTo(e.x, e.y);
              ctx.lineTo(e.x + Math.cos(e.angle) * 280, e.y + Math.sin(e.angle) * 280);
              ctx.stroke();
              ctx.restore();
            }

            ctx.translate(e.x, e.y);
            ctx.rotate(e.angle);
            ctx.shadowColor = COLORS.orange;
            ctx.shadowBlur = e.state === 'dashing' ? 22 : 12;
            ctx.fillStyle = e.state === 'dashing' ? '#ffb703' : COLORS.orange;
            ctx.beginPath();
            ctx.moveTo(e.radius + 7, 0);
            ctx.lineTo(-e.radius, -e.radius * 0.72);
            ctx.lineTo(-e.radius * 0.45, 0);
            ctx.lineTo(-e.radius, e.radius * 0.72);
            ctx.closePath();
            ctx.fill();
          } else {
            ctx.translate(e.x, e.y);
            ctx.rotate(e.spin);
            ctx.shadowColor = COLORS.violet;
            ctx.shadowBlur = 15;
            ctx.fillStyle = COLORS.violet;
            ctx.beginPath();
            for (let k = 0; k < 6; k++) {
              const a = (Math.PI * 2 * k) / 6;
              const px = Math.cos(a) * e.radius;
              const py = Math.sin(a) * e.radius;
              if (k === 0) ctx.moveTo(px, py);
              else ctx.lineTo(px, py);
            }
            ctx.closePath();
            ctx.fill();
            ctx.fillStyle = '#f3e8ff';
            ctx.beginPath();
            ctx.arc(0, 0, 4.5, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.restore();
        }
      }

      function drawEliteCores() {
        for (let i = 0; i < state.eliteCores.length; i++) {
          const c = state.eliteCores[i];
          ctx.save();
          ctx.translate(c.x, c.y);

          ctx.rotate(c.spin);
          ctx.shadowColor = COLORS.elite;
          ctx.shadowBlur = 24;
          ctx.fillStyle = c.flashTimer > 0 ? '#ffffff' : '#2a0818';
          ctx.strokeStyle = c.flashTimer > 0 ? '#ffffff' : COLORS.elite;
          ctx.lineWidth = 3;
          ctx.beginPath();
          for (let k = 0; k < 8; k++) {
            const a = (Math.PI * 2 * k) / 8;
            const px = Math.cos(a) * c.radius;
            const py = Math.sin(a) * c.radius;
            if (k === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          }
          ctx.closePath();
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = COLORS.elite;
          ctx.beginPath();
          ctx.arc(0, 0, 9, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();

          const barY = c.y + c.radius + 12;
          if (c.maxHp <= 8) {
            const spacing = c.maxHp <= 5 ? 11 : 9;
            const pipR = c.maxHp <= 5 ? 3.6 : 3.0;
            for (let h = 0; h < c.maxHp; h++) {
              const ox = c.x + (h - (c.maxHp - 1) / 2) * spacing;
              ctx.fillStyle = h < c.hp ? COLORS.elite : 'rgba(148, 163, 184, 0.28)';
              ctx.beginPath();
              ctx.arc(ox, barY, pipR, 0, Math.PI * 2);
              ctx.fill();
            }
          } else {
            const barW = 56;
            const barH = 6;
            const bx = c.x - barW / 2;
            const by = barY - barH / 2;
            ctx.save();
            ctx.fillStyle = 'rgba(15, 23, 42, 0.82)';
            ctx.fillRect(bx, by, barW, barH);
            ctx.fillStyle = COLORS.elite;
            ctx.fillRect(bx, by, barW * clamp(c.hp / c.maxHp, 0, 1), barH);
            ctx.strokeStyle = 'rgba(255, 30, 86, 0.65)';
            ctx.lineWidth = 1;
            ctx.strokeRect(bx, by, barW, barH);
            ctx.font = '700 10px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'top';
            ctx.fillStyle = '#fda4af';
            ctx.fillText(`${c.hp}/${c.maxHp}`, c.x, by + barH + 3);
            ctx.restore();
          }
        }
      }

      function drawEliteProjectiles() {
        for (let i = 0; i < state.eliteProjectiles.length; i++) {
          const pr = state.eliteProjectiles[i];
          ctx.save();
          ctx.shadowColor = COLORS.elite;
          ctx.shadowBlur = 12;
          ctx.fillStyle = '#ff4d79';
          ctx.beginPath();
          ctx.arc(pr.x, pr.y, pr.radius, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(pr.x, pr.y, pr.radius * 0.45, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
      }

      function drawPlayer() {
        const p = state.player;

        for (let i = 0; i < p.trail.length; i++) {
          const t = p.trail[i];
          const frac = (i + 1) / p.trail.length;
          ctx.fillStyle = t.dash
            ? `rgba(0, 245, 255, ${frac * 0.45})`
            : `rgba(0, 245, 255, ${frac * 0.22})`;
          ctx.beginPath();
          ctx.arc(t.x, t.y, p.radius * frac * (t.dash ? 1.05 : 0.85), 0, Math.PI * 2);
          ctx.fill();
        }

        const invuln = p.hurtInvulnTimer > 0 || p.dashInvulnTimer > 0;
        ctx.save();
        if (p.hurtInvulnTimer > 0 && Math.floor(state.time * 18) % 2 === 0) {
          ctx.globalAlpha = 0.45;
        }

        ctx.shadowColor = invuln ? '#ffffff' : COLORS.player;
        ctx.shadowBlur = p.dashTimer > 0 ? 28 : 18;
        ctx.fillStyle = p.dashTimer > 0 ? '#ffffff' : COLORS.player;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = COLORS.playerCore;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius * 0.48, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        if (pointer.active) {
          ctx.save();
          ctx.strokeStyle = 'rgba(0, 245, 255, 0.28)';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(pointer.originX, pointer.originY, 44, 0, Math.PI * 2);
          ctx.stroke();

          const dx = pointer.currX - pointer.originX;
          const dy = pointer.currY - pointer.originY;
          const d = Math.hypot(dx, dy);
          const knobDist = Math.min(44, d);
          const kx = pointer.originX + (d > 0 ? (dx / d) * knobDist : 0);
          const ky = pointer.originY + (d > 0 ? (dy / d) * knobDist : 0);
          ctx.fillStyle = 'rgba(0, 245, 255, 0.45)';
          ctx.beginPath();
          ctx.arc(kx, ky, 15, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
      }

      function drawEffects() {
        for (let i = 0; i < state.shockwaves.length; i++) {
          const sw = state.shockwaves[i];
          ctx.save();
          ctx.globalAlpha = sw.alpha;
          ctx.strokeStyle = sw.color;
          ctx.lineWidth = 4.5;
          ctx.shadowColor = sw.color;
          ctx.shadowBlur = 18;
          ctx.beginPath();
          ctx.arc(sw.x, sw.y, sw.radius, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        for (let i = 0; i < state.particles.length; i++) {
          const pt = state.particles[i];
          const alpha = clamp(pt.life / pt.maxLife, 0, 1);
          ctx.save();
          ctx.globalAlpha = alpha;
          ctx.fillStyle = pt.color;
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, pt.size * alpha, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }

        ctx.save();
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        for (let i = 0; i < state.floatingTexts.length; i++) {
          const ft = state.floatingTexts[i];
          const alpha = clamp(ft.life / ft.maxLife, 0, 1);
          ctx.globalAlpha = alpha;
          ctx.font = `800 ${ft.size}px Inter, sans-serif`;
          ctx.fillStyle = ft.color;
          ctx.shadowColor = 'rgba(0, 0, 0, 0.85)';
          ctx.shadowBlur = 8;
          ctx.fillText(ft.text, ft.x, ft.y);
        }
        ctx.restore();
      }

      function render() {
        // Her karede HiDPI ölçeklemesini kesin uygula
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        ctx.save();
        if (state.shakeTime > 0 && state.shakePower > 0) {
          const sx = (Math.random() * 2 - 1) * state.shakePower;
          const sy = (Math.random() * 2 - 1) * state.shakePower;
          ctx.translate(sx, sy);
        }

        drawBackground();
        drawVortices();
        drawLasers();
        drawCollectibles();
        drawEnemies();
        drawEliteCores();
        drawEliteProjectiles();
        drawPlayer();
        UpgradeSystem.emit('onDraw', ctx);
        drawEffects();
        drawPoisonAtmosphere();
        ctx.restore();
      }

      /* -----------------------------------------------------------------------
         13. OYUN BAŞLATMA, DURAKLATMA VE BİTİRME
         ----------------------------------------------------------------------- */
      function resetGameState() {
        resizeCanvas();
        state.time = 0;
        state.score = 0;
        state.combo = 1;
        state.comboTimer = 0;
        state.wave = 1;
        state.waveTimer = CONFIG.waveDuration;
        state.poisonActive = false;
        state.poisonTimer = 0;
        state.poisonMaxTimer = CONFIG.poisonBaseInterval;
        state.poisonFlash = 0;
        state.hitstopTimer = 0;
        state.shakeTime = 0;
        state.shakePower = 0;
        state.bannerTimer = 0;
        eventBanner.classList.remove('visible');

        state.totalGoldCollected = 0;
        state.goldCounter = 0;
        state.goldenHearts = 0;
        state.baitKills = 0;
        state.nearMisses = 0;

        UpgradeSystem.reset();
        state.pendingUpgradeChoices = [];

        const p = state.player;
        p.x = viewWidth / 2;
        p.y = viewHeight / 2;
        p.vx = 0;
        p.vy = 0;
        p.facingX = 1;
        p.facingY = 0;
        p.dashTimer = 0;
        p.dashInvulnTimer = 0;
        p.hurtInvulnTimer = 0.8;
        p.dashCharges = getMaxDashCharges();
        p.dashCooldownTimer = 0;
        p.dashChainLock = 0;
        p.trail = [];

        state.shards = [];
        state.shockOrbs = [];
        state.goldenHeartPickups = [];
        state.enemies = [];
        state.eliteCores = [];
        state.eliteProjectiles = [];
        state.vortices = [];
        state.lasers = [];
        state.shockwaves = [];
        state.particles = [];
        state.floatingTexts = [];

        state.enemySpawnTimer = 0.9;
        state.shardSpawnTimer = 0.3;
        state.shockOrbSpawnTimer = 9.5;
        state.eventSpawnTimer = 11.5;
        state.eliteSpawnTimer = 14.0;

        for (let i = 0; i < 4; i++) spawnShard();
        spawnEnemy('chaser');
        spawnEnemy('bouncer');

        hudScore.textContent = '0';
        hudHighScore.textContent = state.highScore.toLocaleString('tr-TR');
        renderUpgradeBadges();
        updateHUDMeters();
      }

      function startGame() {
        Sound.init();
        resetGameState();
        state.mode = 'playing';
        startOverlay.classList.add('hidden');
        pauseOverlay.classList.add('hidden');
        upgradeOverlay.classList.add('hidden');
        gameOverOverlay.classList.add('hidden');
        pauseBtnText.textContent = 'Duraklat';
      }

      function togglePause() {
        if (state.mode === 'playing') {
          state.mode = 'paused';
          pauseOverlay.classList.remove('hidden');
          pauseBtnText.textContent = 'Devam Et';
        } else if (state.mode === 'paused') {
          state.mode = 'playing';
          pauseOverlay.classList.add('hidden');
          pauseBtnText.textContent = 'Duraklat';
        }
      }

      function triggerGameOver() {
        state.mode = 'gameover';
        pointer.active = false;
        pointer.touchId = null;

        const isNewRecord = state.score > 0 && state.score >= state.highScore;
        if (state.score > state.highScore) {
          state.highScore = state.score;
          saveStorageValue(STORAGE_HIGH_SCORE, state.highScore);
        }

        spawnParticles(state.player.x, state.player.y, COLORS.crimson, 36, 90, 320, 2.5, 6);
        spawnParticles(state.player.x, state.player.y, COLORS.cyan, 24, 70, 260, 2, 5);
        addScreenShake(14, 0.35);
        Sound.gameOver();

        finalScore.textContent = state.score.toLocaleString('tr-TR');
        finalHighScore.textContent = state.highScore.toLocaleString('tr-TR');
        finalWave.textContent = String(state.wave);
        finalGold.textContent = String(state.totalGoldCollected);
        finalBaits.textContent = String(state.baitKills);
        finalGrazes.textContent = String(state.nearMisses);
        newRecordBadge.classList.toggle('hidden', !isNewRecord);
        startHighScore.textContent = state.highScore.toLocaleString('tr-TR');
        hudHighScore.textContent = state.highScore.toLocaleString('tr-TR');

        gameOverOverlay.classList.remove('hidden');
      }

      /* -----------------------------------------------------------------------
         14. GİRDİ VE OLAY DİNLEYİCİLERİ
         ----------------------------------------------------------------------- */
      window.addEventListener('keydown', (e) => {
        keys[e.code] = true;

        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space'].includes(e.code)) {
          e.preventDefault();
        }

        if (state.mode === 'start' && (e.code === 'Space' || e.code === 'Enter')) {
          startGame();
          return;
        }

        if (state.mode === 'gameover' && (e.code === 'Space' || e.code === 'Enter')) {
          startGame();
          return;
        }

        if (state.mode === 'upgrade') {
          if (e.code === 'Digit1' || e.code === 'Numpad1') selectUpgrade(0);
          else if (e.code === 'Digit2' || e.code === 'Numpad2') selectUpgrade(1);
          else if (e.code === 'Digit3' || e.code === 'Numpad3') selectUpgrade(2);
          return;
        }

        if (e.code === 'KeyP' || e.code === 'Escape') {
          if (state.mode === 'playing' || state.mode === 'paused') {
            togglePause();
          }
          return;
        }

        if (state.mode === 'playing' && (e.code === 'Space' || e.code === 'ShiftLeft' || e.code === 'ShiftRight')) {
          triggerDash();
        }
      });

      window.addEventListener('keyup', (e) => {
        keys[e.code] = false;
      });

      window.addEventListener('blur', () => {
        for (const k of Object.keys(keys)) keys[k] = false;
        pointer.active = false;
        pointer.touchId = null;
      });

      canvas.addEventListener('mousemove', (e) => {
        pointer.mouseX = e.clientX;
        pointer.mouseY = e.clientY;
      });

      canvas.addEventListener('mousedown', (e) => {
        if (e.button !== 0 || state.mode !== 'playing') return;
        Sound.init();
        const input = getMovementInput();
        if (Math.hypot(input.x, input.y) > 0.1) {
          triggerDash(input.x, input.y);
        } else {
          triggerDash(e.clientX - state.player.x, e.clientY - state.player.y);
        }
      });

      canvas.addEventListener('touchstart', (e) => {
        if (state.mode !== 'playing') return;
        Sound.init();
        if (pointer.touchId === null && e.changedTouches.length > 0) {
          const t = e.changedTouches[0];
          pointer.active = true;
          pointer.touchId = t.identifier;
          pointer.originX = t.clientX;
          pointer.originY = t.clientY;
          pointer.currX = t.clientX;
          pointer.currY = t.clientY;
        }
      }, { passive: true });

      canvas.addEventListener('touchmove', (e) => {
        if (!pointer.active) return;
        for (const t of e.changedTouches) {
          if (t.identifier === pointer.touchId) {
            pointer.currX = t.clientX;
            pointer.currY = t.clientY;
            break;
          }
        }
      }, { passive: true });

      function endTouch(e) {
        for (const t of e.changedTouches) {
          if (t.identifier === pointer.touchId) {
            pointer.active = false;
            pointer.touchId = null;
            break;
          }
        }
      }

      canvas.addEventListener('touchend', endTouch, { passive: true });
      canvas.addEventListener('touchcancel', endTouch, { passive: true });

      btnStart.addEventListener('click', startGame);
      btnRestart.addEventListener('click', startGame);
      btnRestartFromPause.addEventListener('click', startGame);
      btnResume.addEventListener('click', togglePause);
      btnPause.addEventListener('click', togglePause);
      btnSound.addEventListener('click', () => Sound.toggleMute());

      btnDashAction.addEventListener('click', (e) => {
        e.stopPropagation();
        Sound.init();
        triggerDash();
      });

      btnDashAction.addEventListener('touchstart', (e) => {
        e.stopPropagation();
        e.preventDefault();
        Sound.init();
        triggerDash();
      }, { passive: false });

      window.addEventListener('resize', resizeCanvas);
      if (typeof ResizeObserver !== 'undefined') {
        const ro = new ResizeObserver(() => resizeCanvas());
        ro.observe(document.documentElement);
      }

      /* -----------------------------------------------------------------------
         15. ANA ANİMASYON DÖNGÜSÜ VE BAŞLATMA
         ----------------------------------------------------------------------- */
      let lastTimestamp = 0;

      function gameLoop(timestamp) {
        if (!lastTimestamp) lastTimestamp = timestamp;
        const dt = Math.min(0.05, Math.max(0, (timestamp - lastTimestamp) / 1000));
        lastTimestamp = timestamp;

        updateGame(dt);
        render();
        requestAnimationFrame(gameLoop);
      }

      window.onload = function () {
        resizeCanvas();
        updateSoundUI();
        startHighScore.textContent = state.highScore.toLocaleString('tr-TR');
        hudHighScore.textContent = state.highScore.toLocaleString('tr-TR');
        state.player.x = viewWidth / 2;
        state.player.y = viewHeight / 2;
        updateHUDMeters();
        requestAnimationFrame(gameLoop);
      };
    })();
  </script>
</body>
