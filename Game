                const count = baseCount + (uState.level - 1) * 2;
                const projSpeed = 320 + (uState.level - 1) * 35;

                let baseAngle = uState.spin;
                if (uState.patternToggle % 2 === 1) {
                  let nearestDist = Infinity;
                  let targetX = p.x + (p.facingX || 1);
                  let targetY = p.y + (p.facingY || 0);

                  const enemiesList = api.state.enemies;
