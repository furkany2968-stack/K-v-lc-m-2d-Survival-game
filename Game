      /**
       * Mevcut Altın Kalp sayısına (toplanmış + arenada bekleyen) göre
       * bir sonraki Altın Kalp için gereken altın eşiğini döndürür (15 / 20 / 25).
       */
      function getCurrentGoldHeartThreshold() {
        const effectiveHearts = state.goldenHearts + state.goldenHeartPickups.length;
        const steps = CONFIG.goldPerHeartSteps;
        return steps[Math.min(effectiveHearts, steps.length - 1)];
      }

      function trySpawnGoldenHeartIfReady() {
        while (canSpawnMoreGoldenHearts()) {
          const requiredGold = getCurrentGoldHeartThreshold();
          if (state.goldCounter >= requiredGold) {
            state.goldCounter -= requiredGold;
            spawnGoldenHeart();
          } else {
            break;
          }
        }
      }

      /**
       * 10. turdan itibaren zehir hasarı aralığını döndürür:
       * 10. turda 35 sn, her sonraki turda 1 sn kısalır (en az 5 sn).
       */
      function getPoisonInterval() {
        return Math.max(
          CONFIG.poisonMinInterval,
          CONFIG.poisonBaseInterval - (state.wave - CONFIG.poisonStartWave)
        );
      }

      /**
       * Elit Çekirdek canını hesaplar:
       * Başlangıçta 3 can, her 5 turda bir (5., 10., 15. tur...) +1 can artar.
       */
      function getEliteCoreHp() {
        return CONFIG.eliteBaseHp + Math.floor(state.wave / CONFIG.eliteHpWaveStep);
      }

      /**
       * Yeni dalgaya geçişte ortak çalışır; 10. turda zehir atmosferini başlatır,
       * sonraki turlarda sayacı sıfırlamadan yalnızca üst aralığı günceller.
       */
      function onWaveEntered() {
        if (state.wave >= CONFIG.poisonStartWave) {
          const nextInterval = getPoisonInterval();
          if (!state.poisonActive) {
            state.poisonActive = true;
            state.poisonMaxTimer = nextInterval;
            state.poisonTimer = nextInterval;
            state.poisonFlash = 0.7;
            Sound.playTone(165, 0.36, 'sawtooth', 0.09, 95);
            showBanner(`☠️ ZEHİR ATMOSFERİ! HER ${nextInterval} SN HASAR!`, 'emerald', 3.2);
            addFloatingText(state.player.x, state.player.y - 34, '☠️ ZEHİR BAŞLADI!', COLORS.poisonBright, 16);
          } else {
            state.poisonMaxTimer = nextInterval;
            state.poisonTimer = Math.min(state.poisonTimer, state.poisonMaxTimer);
            showBanner(`☠️ DALGA ${state.wave} — ZEHİR ARALIĞI: ${nextInterval}s`, 'emerald', 2.4);
          }
        } else {
          showBanner(`DALGA ${state.wave} BAŞLADI!`, 'cyan', 2.0);
        }
      }

      /* -----------------------------------------------------------------------
         7. GÖRSEL EFEKTLER, UYARI ŞERİDİ VE HUD GÜNCELLEMELERİ
         ----------------------------------------------------------------------- */
      function addScreenShake(power, duration = 0.18) {
        state.shakePower = Math.max(state.shakePower, power);
        state.shakeTime = Math.max(state.shakeTime, duration);
      }

      function addHitstop(seconds) {
        state.hitstopTimer = Math.max(state.hitstopTimer, seconds);
      }

      function showBanner(text, tone = 'crimson', duration = 2.4) {
        eventBanner.textContent = text;
        eventBanner.className = `event-banner ${tone} visible`;
        state.bannerTimer = duration;
      }

      function addFloatingText(x, y, text, color = '#ffffff', size = 14) {
        state.floatingTexts.push({
          x,
          y,
          vy: -48,
          text,
          color,
          size,
          life: 0.95,
          maxLife: 0.95
        });
      }

      function spawnParticles(x, y, color, count = 12, speedMin = 60, speedMax = 240, sizeMin = 2, sizeMax = 4.5) {
        for (let i = 0; i < count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const spd = rand(speedMin, speedMax);
          const life = rand(0.25, 0.65);
          state.particles.push({
            x,
            y,
            vx: Math.cos(angle) * spd,
            vy: Math.sin(angle) * spd,
            color,
            size: rand(sizeMin, sizeMax),
            life,
            maxLife: life
          });
        }
      }

      function addScore(points, popHUD = true) {
        const gained = Math.round(points);
        state.score += gained;
        if (state.score > state.highScore) {
          state.highScore = state.score;
          saveStorageValue(STORAGE_HIGH_SCORE, state.highScore);
        }
        hudScore.textContent = state.score.toLocaleString('tr-TR');
        hudHighScore.textContent = state.highScore.toLocaleString('tr-TR');
        if (popHUD) {
          hudScore.classList.remove('pop');
          void hudScore.offsetWidth;
          hudScore.classList.add('pop');
          setTimeout(() => hudScore.classList.remove('pop'), 130);
        }
      }

      function updateSoundUI() {
        soundIconOn.style.display = Sound.muted ? 'none' : 'block';
        soundIconOff.style.display = Sound.muted ? 'block' : 'none';
        soundBtnText.textContent = Sound.muted ? 'Ses: Kapalı' : 'Ses: Açık';
        btnSound.classList.toggle('active-muted', Sound.muted);
      }

      function renderUpgradeBadges() {
        upgradeBadgesEl.innerHTML = '';
        for (let i = 0; i < UpgradeSystem.acquiredList.length; i++) {
          const entry = UpgradeSystem.acquiredList[i];
          const def = entry.def;
          const el = document.createElement('span');
          el.className = 'upg-badge';
          let statusHTML = '';
          if (typeof def.getBadgeMeta === 'function') {
            const meta = def.getBadgeMeta(entry.state);
            if (meta) {
              if (meta.cls) el.classList.add(meta.cls);
              if (meta.label) statusHTML = ` <span>(${meta.label})</span>`;
            }
          }
          el.innerHTML = `<span>${def.icon}</span><span>${def.name}</span><span class="upg-lvl">Sv.${entry.state.level}</span>${statusHTML}`;
          upgradeBadgesEl.appendChild(el);
        }
      }

      function renderDashPips(container, charges, maxCharges) {
        if (container.children.length !== maxCharges) {
          container.innerHTML = '';
          for (let i = 0; i < maxCharges; i++) {
            const dot = document.createElement('span');
            dot.className = 'dash-pip';
            container.appendChild(dot);
          }
        }
        for (let i = 0; i < maxCharges; i++) {
          container.children[i].classList.toggle('ready', i < charges);
        }
      }

      function updateHeartsHUD(popIndex = -1) {
        const slots = hudHeartsRow.querySelectorAll('.heart-slot');
        slots.forEach((slot, idx) => {
          const filled = idx < state.goldenHearts;
          slot.classList.toggle('filled', filled);
          if (idx === popIndex) {
            slot.classList.remove('pop');
            void slot.offsetWidth;
            slot.classList.add('pop');
            setTimeout(() => slot.classList.remove('pop'), 240);
          }
        });
      }

      function updateHUDMeters() {
        // Kombo
        hudComboText.textContent = `x${state.combo}`;
        const comboRatio = state.combo > 1 ? clamp(state.comboTimer / CONFIG.comboDuration, 0, 1) : 0;
        hudComboBar.style.width = `${comboRatio * 100}%`;

        // Altın Kalp & Kademeli Altın Sayacı (1. kalp: 15, 2. kalp: 20, 3. kalp: 25)
        updateHeartsHUD();
        if (!canSpawnMoreGoldenHearts()) {
          hudGoldText.textContent = '🪙 MAKS';
          hudGoldBar.style.width = '100%';
        } else {
          const goldReq = getCurrentGoldHeartThreshold();
          hudGoldText.textContent = `🪙 ${state.goldCounter}/${goldReq}`;
          const goldRatio = clamp(state.goldCounter / goldReq, 0, 1);
          hudGoldBar.style.width = `${goldRatio * 100}%`;
        }

        // Atılma Yükleri & Dolum Halkası
        const p = state.player;
        const maxCharges = getMaxDashCharges();
        const cooldownTotal = getDashCooldown();
        const progress = p.dashCharges >= maxCharges
          ? 1
          : clamp(1 - p.dashCooldownTimer / cooldownTotal, 0, 1);

        renderDashPips(hudDashPips, p.dashCharges, maxCharges);
        renderDashPips(btnDashPips, p.dashCharges, maxCharges);

        hudDashBar.style.width = `${progress * 100}%`;
        hudDashBar.classList.toggle('cooling', p.dashCharges === 0);

        if (p.dashCharges > 0) {
          hudDashText.textContent = maxCharges > 1 ? `${p.dashCharges}/${maxCharges}` : 'HAZIR';
          hudDashText.style.color = 'var(--cyan)';
          btnDashAction.classList.remove('on-cooldown');
        } else {
          hudDashText.textContent = `${p.dashCooldownTimer.toFixed(1)}s`;
          hudDashText.style.color = 'var(--text-muted)';
          btnDashAction.classList.add('on-cooldown');
        }

        const ringRatio = p.dashCharges > 0 && p.dashCharges === maxCharges ? 1 : progress;
        btnDashRingProgress.style.strokeDashoffset = `${DASH_RING_CIRCUMFERENCE * (1 - ringRatio)}`;

        // Dalga Çubuğu
        hudWaveLabel.textContent = `DALGA ${state.wave}`;
        const waveProgress = clamp(1 - state.waveTimer / CONFIG.waveDuration, 0, 1);
        hudWaveBar.style.width = `${waveProgress * 100}%`;
        hudWaveTimer.textContent = `${Math.max(0, Math.ceil(state.waveTimer))}s`;

        // Zehir Geri Sayım Çubuğu (10. Turdan itibaren görünür)
        if (state.poisonActive) {
          hudPoisonChip.classList.remove('hidden');
          const secLeft = Math.max(0, Math.ceil(state.poisonTimer));
          hudPoisonText.textContent = `☠️ ${secLeft}s`;
          const poisonRatio = clamp(state.poisonTimer / Math.max(1, state.poisonMaxTimer), 0, 1);
          hudPoisonBar.style.width = `${poisonRatio * 100}%`;
          hudPoisonChip.classList.toggle('danger', state.poisonTimer <= 5);
        } else {
          hudPoisonChip.classList.add('hidden');
          hudPoisonChip.classList.remove('danger');
        }
      }

      /* -----------------------------------------------------------------------
         8. VARLIK OLUŞTURMA (SPAWNERS)
         ----------------------------------------------------------------------- */
      function getSafeSpawnPosition(minDistFromPlayer = 180, margin = 48) {
        const m = CONFIG.arenaMargin + margin;
        const maxX = Math.max(m + 20, viewWidth - m);
        const maxY = Math.max(m + 20, viewHeight - m);
        for (let attempt = 0; attempt < 24; attempt++) {
          const x = rand(m, maxX);
          const y = rand(m + 34, maxY); // Üst HUD bölgesinden biraz aşağı
          if (dist(x, y, state.player.x, state.player.y) >= minDistFromPlayer) {
            return { x, y };
          }
        }
        return { x: rand(m, maxX), y: rand(m + 34, maxY) };
      }

      function getEdgeSpawnPosition() {
        const pad = CONFIG.arenaMargin + 26;
        const side = Math.floor(Math.random() * 4);
        let x, y;
        if (side === 0) { x = rand(pad, viewWidth - pad); y = pad; }
        else if (side === 1) { x = viewWidth - pad; y = rand(pad, viewHeight - pad); }
        else if (side === 2) { x = rand(pad, viewWidth - pad); y = viewHeight - pad; }
        else { x = pad; y = rand(pad, viewHeight - pad); }

        if (dist(x, y, state.player.x, state.player.y) < 160) {
          x = viewWidth - x;
          y = viewHeight - y;
        }
        return { x, y };
      }

      function spawnShard() {
        const pos = getSafeSpawnPosition(110, 44);
        state.shards.push({
          x: pos.x,
          y: pos.y,
          radius: CONFIG.shardRadius,
          pulse: Math.random() * Math.PI * 2,
          life: 16
        });
      }

      function spawnShockOrb() {
        const pos = getSafeSpawnPosition(150, 56);
        state.shockOrbs.push({
          x: pos.x,
          y: pos.y,
          radius: CONFIG.shockOrbRadius,
          pulse: Math.random() * Math.PI * 2,
          life: 14
        });
      }

      function spawnGoldenHeart() {
        const pos = getSafeSpawnPosition(135, 58);
        state.goldenHeartPickups.push({
          x: pos.x,
          y: pos.y,
          radius: CONFIG.goldenHeartRadius,
          pulse: 0
        });
        spawnParticles(pos.x, pos.y, COLORS.gold, 22, 70, 220, 2.5, 5);
        addFloatingText(pos.x, pos.y - 20, '♥ ALTIN KALP!', COLORS.goldBright, 15);
        showBanner('♥ ARENADA ALTIN KALP BELİRDİ!', 'gold', 2.4);
        Sound.goldenHeartSpawn();
      }

      function spawnEnemy(forcedType = null) {
        const pos = getEdgeSpawnPosition();
        const waveScale = 1 + (state.wave - 1) * 0.1 + Math.min(0.45, state.time / 220);

        let type = forcedType;
        if (!type) {
          const r = Math.random();
          if (state.wave === 1 && state.time < 12) {
            type = r < 0.72 ? 'chaser' : 'bouncer';
          } else if (r < 0.44) {
            type = 'chaser';
          } else if (r < 0.74) {
            type = 'lancer';
          } else {
            type = 'bouncer';
          }
        }

        if (type === 'chaser') {
          state.enemies.push({
            id: Math.random(),
            type: 'chaser',
            x: pos.x,
            y: pos.y,
            vx: 0,
            vy: 0,
            radius: 13,
            speed: rand(125, 158) * waveScale,
            slowTimer: 0,
            slowFactor: 1,
            grazeCooldown: 0,
            spin: Math.random() * Math.PI * 2
          });
        } else if (type === 'lancer') {
          const angle = Math.atan2(state.player.y - pos.y, state.player.x - pos.x);
          state.enemies.push({
            id: Math.random(),
            type: 'lancer',
            x: pos.x,
            y: pos.y,
            vx: 0,
            vy: 0,
            radius: 12,
            state: 'aiming', // 'aiming' -> 'dashing' -> 'recover'
            timer: 1.05,
            angle,
            dashSpeed: 590 * Math.min(1.42, waveScale),
            slowTimer: 0,
            slowFactor: 1,
            grazeCooldown: 0,
            hitElites: new Set()
          });
        } else {
          const angle = rand(0, Math.PI * 2);
          const spd = rand(185, 235) * waveScale;
          state.enemies.push({
            id: Math.random(),
            type: 'bouncer',
            x: pos.x,
            y: pos.y,
            vx: Math.cos(angle) * spd,
            vy: Math.sin(angle) * spd,
            radius: 14,
            slowTimer: 0,
            slowFactor: 1,
            grazeCooldown: 0,
            spin: 0
          });
        }
      }

      function spawnVortex() {
        const pos = getSafeSpawnPosition(170, 120);
        state.vortices.push({
          x: pos.x,
          y: pos.y,
          radius: CONFIG.vortexRadius,
          timer: 9.0,
          maxLife: 9.0,
