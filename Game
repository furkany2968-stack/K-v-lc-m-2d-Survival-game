      function spawnLaserBarrier() {
        const horizontal = Math.random() < 0.5;
        const margin = CONFIG.arenaMargin + 60;
        let x1, y1, x2, y2;
        if (horizontal) {
          const y = clamp(state.player.y + rand(-110, 110), margin + 40, viewHeight - margin);
          x1 = CONFIG.arenaMargin;
          y1 = y;
          x2 = viewWidth - CONFIG.arenaMargin;
          y2 = y;
        } else {
          const x = clamp(state.player.x + rand(-120, 120), margin, viewWidth - margin);
          x1 = x;
          y1 = CONFIG.arenaMargin;
          x2 = x;
          y2 = viewHeight - CONFIG.arenaMargin;
