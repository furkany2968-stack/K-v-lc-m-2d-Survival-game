      /* -----------------------------------------------------------------------
         5B. TAK-ÇALIŞTIR HOOK SİSTEMİ (UpgradeSystem)
         - Ön-indeksli hook kovaları (hookBuckets) ile sıfır kare-içi tahsis
         - Önbelleklenmiş istatistikler (computedStats) yalnızca başlangıç/alım anında hesaplanır
         ----------------------------------------------------------------------- */
      const HOOK_NAMES = [
        'onAcquire',
        'onReset',
        'onUpdate',
        'onDraw',
        'onDash',
        'onGoldCollect',
        'onNearMiss',
        'onTakeDamage',
        'onShockwave'
      ];

      const UpgradeSystem = {
        poolById: Object.create(null),
        acquiredMap: Object.create(null), // id -> { def, state: { level, ... } }
        acquiredList: [],                 // Sıralı aktif yükseltme dizisi
        hookBuckets: Object.create(null), // hookName -> [{ def, state }]
        computedStats: {
          moveSpeedMult: 1,
          magnetRadiusMult: 1,
          dashCooldownMult: 1,
          maxDashChargesBonus: 0,
          shockwaveRadiusMult: 1,
          grazeMarginBonus: 0,
          grazePointsBonus: 0
        },

        init() {
          for (let i = 0; i < HOOK_NAMES.length; i++) {
            this.hookBuckets[HOOK_NAMES[i]] = [];
          }
          for (let i = 0; i < UPGRADES_POOL.length; i++) {
            const def = UPGRADES_POOL[i];
            this.poolById[def.id] = def;
          }
        },

        reset() {
          // Mevcut yeteneklerin onReset kancasını çalıştır
          const resetBucket = this.hookBuckets.onReset;
          for (let i = 0; i < resetBucket.length; i++) {
            const entry = resetBucket[i];
            entry.def.onReset(upgradeAPI, entry.state);
          }

          this.acquiredMap = Object.create(null);
          this.acquiredList.length = 0;
          for (let i = 0; i < HOOK_NAMES.length; i++) {
            this.hookBuckets[HOOK_NAMES[i]].length = 0;
          }
          this.recalculateStats();
        },

        getLevel(id) {
          const entry = this.acquiredMap[id];
          return entry ? entry.state.level : 0;
        },

        getAvailableUpgrades() {
          const list = [];
          for (let i = 0; i < UPGRADES_POOL.length; i++) {
            const def = UPGRADES_POOL[i];
            const maxLvl = def.maxLevel || 1;
            if (this.getLevel(def.id) < maxLvl) {
              list.push(def);
            }
          }
          return list;
        },

        acquire(id) {
          const def = this.poolById[id];
          if (!def) return null;

          let entry = this.acquiredMap[id];
          if (!entry) {
            entry = { def, state: { level: 1 } };
            this.acquiredMap[id] = entry;
            this.acquiredList.push(entry);
            this.rebuildHookBuckets();
          } else {
            entry.state.level++;
          }

          this.recalculateStats();

          if (typeof def.onAcquire === 'function') {
            def.onAcquire(upgradeAPI, entry.state);
          }
          return entry;
        },

        rebuildHookBuckets() {
          for (let h = 0; h < HOOK_NAMES.length; h++) {
            this.hookBuckets[HOOK_NAMES[h]].length = 0;
          }
          for (let i = 0; i < this.acquiredList.length; i++) {
            const entry = this.acquiredList[i];
            for (let h = 0; h < HOOK_NAMES.length; h++) {
              const hookName = HOOK_NAMES[h];
              if (typeof entry.def[hookName] === 'function') {
                this.hookBuckets[hookName].push(entry);
              }
            }
          }
        },

        recalculateStats() {
          const s = this.computedStats;
          s.moveSpeedMult = 1;
          s.magnetRadiusMult = 1;
          s.dashCooldownMult = 1;
          s.maxDashChargesBonus = 0;
          s.shockwaveRadiusMult = 1;
          s.grazeMarginBonus = 0;
          s.grazePointsBonus = 0;

          for (let i = 0; i < this.acquiredList.length; i++) {
            const entry = this.acquiredList[i];
            const mod = entry.def.modifiers;
            if (!mod) continue;
            const lvl = entry.state.level;

            if (mod.moveSpeedMult) s.moveSpeedMult *= Math.pow(mod.moveSpeedMult, lvl);
            if (mod.magnetRadiusMult) s.magnetRadiusMult *= Math.pow(mod.magnetRadiusMult, lvl);
            if (mod.dashCooldownMult) s.dashCooldownMult *= Math.pow(mod.dashCooldownMult, lvl);
            if (mod.shockwaveRadiusMult) s.shockwaveRadiusMult *= Math.pow(mod.shockwaveRadiusMult, lvl);
            if (mod.maxDashChargesBonus) s.maxDashChargesBonus += mod.maxDashChargesBonus * lvl;
            if (mod.grazeMarginBonus) s.grazeMarginBonus += mod.grazeMarginBonus * lvl;
            if (mod.grazePointsBonus) s.grazePointsBonus += mod.grazePointsBonus * lvl;
          }
        },

        emit(hookName, payload) {
          const bucket = this.hookBuckets[hookName];
          if (!bucket || bucket.length === 0) return;
          for (let i = 0; i < bucket.length; i++) {
            const entry = bucket[i];
            entry.def[hookName](upgradeAPI, payload, entry.state);
          }
        }
      };

      // Tek seferlik oluşturulan (sıfır kare-içi tahsis) Hook API Bağlamı
